{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/payment.post.request.schema.json",
  "title": "payment.post request",
  "type": "object",
  "allOf": [
    {"$ref": "request.schema.json"},
    {
      "properties": {
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "payment_id": {"type": "integer", "minimum": 1},
            "payment_ids": {
              "type": "array",
              "minItems": 2,
              "maxItems": 100,
              "uniqueItems": true,
              "items": {"type": "integer", "minimum": 1}
            }
          },
          "oneOf": [
            {"required": ["payment_id"]},
            {"required": ["payment_ids"]}
          ]
        }
      }
    }
  ]
}
