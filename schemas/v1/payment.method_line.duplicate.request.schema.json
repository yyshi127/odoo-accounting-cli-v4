{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/payment.method_line.duplicate.request.schema.json",
  "title": "payment.method_line.duplicate request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "context",
    "parameters"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "request_id": {
      "$ref": "request.schema.json#/properties/request_id"
    },
    "context": {
      "$ref": "request.schema.json#/$defs/context"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "payment_method_line_id"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "payment_method_line_id": {
          "$ref": "#/$defs/id"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$(?![\\s\\S])"
    }
  }
}
