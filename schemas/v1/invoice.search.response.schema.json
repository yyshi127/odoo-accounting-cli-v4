{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/invoice.search.response.schema.json",
  "title": "invoice.search response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "success", "capability", "status", "data", "warnings", "error", "odoo", "audit"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": ["string", "null"], "format": "uuid"},
    "success": {"type": "boolean"},
    "capability": {"const": "invoice.search"},
    "status": {"type": "string", "minLength": 1},
    "data": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/data"}]},
    "warnings": {"type": "array", "items": {"type": "object"}},
    "error": {"oneOf": [{"type": "null"}, {"$ref": "response.schema.json#/$defs/error"}]},
    "odoo": {"$ref": "response.schema.json#/$defs/odoo"},
    "audit": {"$ref": "response.schema.json#/$defs/audit"}
  },
  "allOf": [{
    "if": {"properties": {"success": {"const": true}}, "required": ["success"]},
    "then": {
      "properties": {
        "request_id": {"type": "string", "format": "uuid"},
        "status": {"const": "verified"},
        "data": {"$ref": "#/$defs/data"},
        "error": {"type": "null"}
      }
    },
    "else": {
      "properties": {
        "data": {"type": "null"},
        "error": {"$ref": "response.schema.json#/$defs/error"}
      }
    }
  }],
  "$defs": {
    "money": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
    "journal": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "code", "name"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "code": {"type": "string", "minLength": 1, "maxLength": 5},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "currency": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "code"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "code": {"type": "string", "minLength": 1, "maxLength": 3}
      }
    },
    "partner": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "move_type", "state", "date", "invoice_date", "invoice_date_due", "ref", "payment_reference", "invoice_origin", "journal", "company_id", "currency", "partner", "amount_untaxed", "amount_tax", "amount_total", "amount_residual", "payment_state"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "name": {"type": ["string", "null"], "minLength": 1},
        "move_type": {"enum": ["out_invoice", "out_refund", "in_invoice", "in_refund"]},
        "state": {"enum": ["draft", "posted", "cancel"]},
        "date": {"type": "string", "format": "date"},
        "invoice_date": {"type": ["string", "null"], "format": "date"},
        "invoice_date_due": {"type": ["string", "null"], "format": "date"},
        "ref": {"type": ["string", "null"], "minLength": 1},
        "payment_reference": {"type": ["string", "null"], "minLength": 1},
        "invoice_origin": {"type": ["string", "null"], "minLength": 1},
        "journal": {"$ref": "#/$defs/journal"},
        "company_id": {"type": "integer", "minimum": 1},
        "currency": {"$ref": "#/$defs/currency"},
        "partner": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/partner"}]},
        "amount_untaxed": {"$ref": "#/$defs/money"},
        "amount_tax": {"$ref": "#/$defs/money"},
        "amount_total": {"$ref": "#/$defs/money"},
        "amount_residual": {"$ref": "#/$defs/money"},
        "payment_state": {"enum": ["not_paid", "in_payment", "paid", "partial", "reversed", "blocked", "invoicing_legacy"]}
      }
    },
    "data": {
      "type": "object", "additionalProperties": false,
      "required": ["items", "has_more", "next_cursor"],
      "properties": {
        "items": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/item"}},
        "has_more": {"type": "boolean"},
        "next_cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096}
      }
    }
  }
}
