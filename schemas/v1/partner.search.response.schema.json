{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/partner.search.response.schema.json",
  "title": "partner.search response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "success", "capability", "status", "data", "warnings", "error", "odoo", "audit"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": ["string", "null"], "format": "uuid"},
    "success": {"type": "boolean"},
    "capability": {"const": "partner.search"},
    "status": {"type": "string", "minLength": 1},
    "data": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/data"}]},
    "warnings": {"type": "array", "items": {"type": "object"}},
    "error": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "response.schema.json#/$defs/error"}
      ]
    },
    "odoo": {"$ref": "response.schema.json#/$defs/odoo"},
    "audit": {"$ref": "response.schema.json#/$defs/audit"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"success": {"const": true}},
        "required": ["success"]
      },
      "then": {
        "properties": {
          "request_id": {"type": "string", "format": "uuid"},
          "status": {"const": "verified"},
          "data": {"$ref": "#/$defs/data"},
          "error": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "data": {"type": "null"},
          "error": {"$ref": "response.schema.json#/$defs/error"}
        }
      }
    }
  ],
  "$defs": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "has_more", "next_cursor"],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/item"}
        },
        "has_more": {"type": "boolean"},
        "next_cursor": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"has_more": {"const": true}},
            "required": ["has_more"]
          },
          "then": {
            "properties": {
              "items": {"type": "array", "minItems": 1},
              "next_cursor": {"type": "string"}
            }
          },
          "else": {
            "properties": {"next_cursor": {"type": "null"}}
          }
        }
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "display_name",
        "company_type",
        "active",
        "vat",
        "reference",
        "email",
        "phone",
        "mobile",
        "street",
        "street2",
        "city",
        "zip",
        "state",
        "country",
        "language",
        "company_id",
        "parent",
        "customer_rank",
        "supplier_rank"
      ],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "company_type": {"enum": ["person", "company"]},
        "active": {"type": "boolean"},
        "vat": {"type": ["string", "null"]},
        "reference": {"type": ["string", "null"]},
        "email": {"type": ["string", "null"]},
        "phone": {"type": ["string", "null"]},
        "mobile": {"type": ["string", "null"]},
        "street": {"type": ["string", "null"]},
        "street2": {"type": ["string", "null"]},
        "city": {"type": ["string", "null"]},
        "zip": {"type": ["string", "null"]},
        "state": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/named"}
          ]
        },
        "country": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/named"}
          ]
        },
        "language": {"type": ["string", "null"]},
        "company_id": {"type": ["integer", "null"], "minimum": 1},
        "parent": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/named"}
          ]
        },
        "customer_rank": {"type": "integer", "minimum": 0},
        "supplier_rank": {"type": "integer", "minimum": 0}
      }
    },
    "named": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1}
      }
    }
  }
}
