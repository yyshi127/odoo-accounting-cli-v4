{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/tax.processing_settings.get.response.schema.json",
  "title": "tax.processing_settings.get response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "success",
    "capability",
    "status",
    "data",
    "warnings",
    "error",
    "odoo",
    "audit"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "success": {
      "type": "boolean"
    },
    "capability": {
      "const": "tax.processing_settings.get"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/item"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "response.schema.json#/$defs/error"
        }
      ]
    },
    "odoo": {
      "$ref": "response.schema.json#/$defs/odoo"
    },
    "audit": {
      "$ref": "response.schema.json#/$defs/audit"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "success": {
            "const": true
          }
        },
        "required": [
          "success"
        ]
      },
      "then": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "const": "verified"
          },
          "data": {
            "$ref": "#/$defs/item"
          },
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "data": {
            "type": "null"
          },
          "error": {
            "$ref": "response.schema.json#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "company_id": {
          "type": "integer",
          "minimum": 1
        },
        "country_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "cash_basis_transition_account_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "active": {
          "type": "boolean"
        },
        "price_include": {
          "type": "boolean"
        },
        "analytic": {
          "type": "boolean"
        },
        "is_used": {
          "type": "boolean"
        },
        "has_negative_factor": {
          "type": "boolean"
        },
        "tax_scope": {
          "enum": [
            null,
            "service",
            "consu"
          ]
        },
        "tax_exigibility": {
          "enum": [
            "on_invoice",
            "on_payment"
          ]
        },
        "price_include_override": {
          "enum": [
            null,
            "tax_included",
            "tax_excluded"
          ]
        },
        "children_tax_ids": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "invoice_repartition_line_ids": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "refund_repartition_line_ids": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "required": [
        "active",
        "analytic",
        "cash_basis_transition_account_id",
        "children_tax_ids",
        "company_id",
        "country_id",
        "has_negative_factor",
        "id",
        "invoice_repartition_line_ids",
        "is_used",
        "price_include",
        "price_include_override",
        "refund_repartition_line_ids",
        "tax_exigibility",
        "tax_scope"
      ]
    }
  }
}
