{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/bank.transaction.get.response.schema.json",
  "title": "bank.transaction.get response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "success",
    "capability",
    "status",
    "data",
    "warnings",
    "error",
    "odoo",
    "audit"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "success": {
      "type": "boolean"
    },
    "capability": {
      "const": "bank.transaction.get"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/item"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "response.schema.json#/$defs/error"
        }
      ]
    },
    "odoo": {
      "$ref": "response.schema.json#/$defs/odoo"
    },
    "audit": {
      "$ref": "response.schema.json#/$defs/audit"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "success": {
            "const": true
          }
        },
        "required": [
          "success"
        ]
      },
      "then": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "const": "verified"
          },
          "data": {
            "$ref": "#/$defs/item"
          },
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "data": {
            "type": "null"
          },
          "error": {
            "$ref": "response.schema.json#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "company_id", "date", "payment_date", "name", "reference", "partner", "journal", "amount", "currency", "move", "reconciled", "statement_id"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "company_id": {"type": "integer", "minimum": 1},
        "date": {"type": "string", "format": "date"},
        "payment_date": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date"}]},
        "name": {"$ref": "bank.transaction.list.response.schema.json#/$defs/nullableText"},
        "reference": {"$ref": "bank.transaction.list.response.schema.json#/$defs/nullableText"},
        "partner": {"oneOf": [{"type": "null"}, {"$ref": "bank.transaction.list.response.schema.json#/$defs/partner"}]},
        "journal": {"$ref": "bank.transaction.list.response.schema.json#/$defs/journal"},
        "amount": {"$ref": "bank.transaction.list.response.schema.json#/$defs/decimal"},
        "currency": {"$ref": "bank.transaction.list.response.schema.json#/$defs/currency"},
        "move": {"$ref": "bank.transaction.list.response.schema.json#/$defs/move"},
        "reconciled": {"type": "boolean"},
        "statement_id": {"type": ["integer", "null"], "minimum": 1},
        "account_number": {"$ref": "bank.transaction.list.response.schema.json#/$defs/nullableText"},
        "partner_name": {"$ref": "bank.transaction.list.response.schema.json#/$defs/nullableText"}
      }
    }
  }
}
