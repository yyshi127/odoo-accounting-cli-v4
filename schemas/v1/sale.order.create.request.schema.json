{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/sale.order.create.request.schema.json",
  "title": "sale.order.create request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "context", "parameters"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
    "context": {"$ref": "request.schema.json#/$defs/context"},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["partner_id", "pricelist_id", "date_order", "client_order_ref", "validity_date", "commitment_date", "payment_term_id", "lines"],
      "properties": {
        "partner_id": {"$ref": "#/$defs/id"},
        "pricelist_id": {"$ref": "#/$defs/id"},
        "date_order": {"$ref": "#/$defs/datetime"},
        "client_order_ref": {"$ref": "#/$defs/nullable_text"},
        "validity_date": {"type": ["string", "null"], "format": "date"},
        "commitment_date": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/datetime"}]},
        "payment_term_id": {"$ref": "#/$defs/nullable_id"},
        "lines": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"$ref": "#/$defs/line"}}
      }
    }
  },
  "$defs": {
    "id": {"type": "integer", "minimum": 1},
    "nullable_id": {"type": ["integer", "null"], "minimum": 1},
    "datetime": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$"},
    "nullable_text": {"type": ["string", "null"], "minLength": 1, "maxLength": 200, "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$"},
    "positive_decimal": {"type": "string", "maxLength": 256, "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9])$(?![\\s\\S])"},
    "nonnegative_decimal": {"type": "string", "maxLength": 256, "pattern": "^(?:0|[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9])$(?![\\s\\S])"},
    "percentage_decimal": {"type": "string", "maxLength": 256, "pattern": "^(?:0|100|(?:[0-9]|[1-9][0-9])(?:\\.[0-9]*[1-9])?)$(?![\\s\\S])"},
    "line": {
      "type": "object", "additionalProperties": false,
      "required": ["product_id", "name", "quantity", "uom_id", "price_unit", "discount", "tax_ids"],
      "properties": {
        "product_id": {"$ref": "#/$defs/id"}, "name": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$"},
        "quantity": {"$ref": "#/$defs/positive_decimal"}, "uom_id": {"$ref": "#/$defs/id"}, "price_unit": {"$ref": "#/$defs/nonnegative_decimal"},
        "discount": {"$ref": "#/$defs/percentage_decimal"}, "tax_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    }
  }
}
