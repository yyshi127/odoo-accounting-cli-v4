{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/journal_item.analysis.summary.response.schema.json",
  "title": "journal_item.analysis.summary response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "success", "capability", "status", "data", "warnings", "error", "odoo", "audit"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": ["string", "null"], "format": "uuid"},
    "success": {"type": "boolean"},
    "capability": {"const": "journal_item.analysis.summary"},
    "status": {"type": "string", "minLength": 1},
    "data": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/data"}]},
    "warnings": {"type": "array", "items": {"type": "object"}},
    "error": {"oneOf": [{"type": "null"}, {"$ref": "response.schema.json#/$defs/error"}]},
    "odoo": {"$ref": "response.schema.json#/$defs/odoo"},
    "audit": {"$ref": "response.schema.json#/$defs/audit"}
  },
  "allOf": [{"if": {"properties": {"success": {"const": true}}, "required": ["success"]}, "then": {"properties": {"request_id": {"type": "string", "format": "uuid"}, "status": {"const": "verified"}, "data": {"$ref": "#/$defs/data"}, "error": {"type": "null"}}}, "else": {"properties": {"data": {"type": "null"}, "error": {"$ref": "response.schema.json#/$defs/error"}}}}],
  "$defs": {
    "currency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "code": {"type": "string", "minLength": 1, "maxLength": 3}
      }
    },
    "decimal": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code", "name"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "code": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "amounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_count", "debit", "credit", "balance"],
      "properties": {
        "row_count": {"type": "integer", "minimum": 0},
        "debit": {"$ref": "#/$defs/decimal"},
        "credit": {"$ref": "#/$defs/decimal"},
        "balance": {"$ref": "#/$defs/decimal"}
      }
    },
    "group_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "row_count", "debit", "credit", "balance"],
      "properties": {
        "group": {"$ref": "#/$defs/group"},
        "row_count": {"type": "integer", "minimum": 1},
        "debit": {"$ref": "#/$defs/decimal"},
        "credit": {"$ref": "#/$defs/decimal"},
        "balance": {"$ref": "#/$defs/decimal"}
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["company_id", "date_from", "date_to", "basis", "group_by", "company_currency", "groups", "totals"],
      "properties": {
        "company_id": {"type": "integer", "minimum": 1},
        "date_from": {"type": "string", "format": "date"},
        "date_to": {"type": "string", "format": "date"},
        "basis": {"const": "posted_entries"},
        "group_by": {"enum": ["account", "journal"]},
        "company_currency": {"$ref": "#/$defs/currency"},
        "groups": {"type": "array", "items": {"$ref": "#/$defs/group_row"}},
        "totals": {"$ref": "#/$defs/amounts"}
      }
    }
  }
}
