{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/tax.usage_lines.list.response.schema.json",
  "title": "tax.usage_lines.list response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "success",
    "capability",
    "status",
    "data",
    "warnings",
    "error",
    "odoo",
    "audit"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "success": {
      "type": "boolean"
    },
    "capability": {
      "const": "tax.usage_lines.list"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/data"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "response.schema.json#/$defs/error"
        }
      ]
    },
    "odoo": {
      "$ref": "response.schema.json#/$defs/odoo"
    },
    "audit": {
      "$ref": "response.schema.json#/$defs/audit"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "success": {
            "const": true
          }
        },
        "required": [
          "success"
        ]
      },
      "then": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "const": "verified"
          },
          "data": {
            "$ref": "#/$defs/data"
          },
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "data": {
            "type": "null"
          },
          "error": {
            "$ref": "response.schema.json#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "has_more",
        "next_cursor"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "has_more": {
          "type": "boolean"
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "has_more": {
                "const": true
              }
            },
            "required": [
              "has_more"
            ]
          },
          "then": {
            "properties": {
              "items": {
                "type": "array",
                "minItems": 1
              },
              "next_cursor": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "next_cursor": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "company_id": {
          "type": "integer",
          "minimum": 1
        },
        "move_id": {
          "type": "integer",
          "minimum": 1
        },
        "account_id": {
          "type": "integer",
          "minimum": 1
        },
        "currency_id": {
          "type": "integer",
          "minimum": 1
        },
        "tax_line_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "group_tax_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "tax_repartition_line_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "tax_ids": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "parent_state": {
          "enum": [
            "draft",
            "posted",
            "cancel"
          ]
        },
        "balance": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$(?![\\s\\S])"
        },
        "amount_currency": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$(?![\\s\\S])"
        }
      },
      "required": [
        "account_id",
        "amount_currency",
        "balance",
        "company_id",
        "currency_id",
        "date",
        "group_tax_id",
        "id",
        "move_id",
        "name",
        "parent_state",
        "tax_ids",
        "tax_line_id",
        "tax_repartition_line_id"
      ]
    }
  }
}
