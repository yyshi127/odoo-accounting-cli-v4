{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/journal_entry.lines.update.request.schema.json",
  "title": "journal_entry.lines.update request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "context",
    "parameters"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "request_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "context": {
      "$ref": "request.schema.json#/$defs/context"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "move_id",
        "lines"
      ],
      "properties": {
        "move_id": {
          "type": "integer",
          "minimum": 1
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "line_id",
              "changes"
            ],
            "properties": {
              "line_id": {
                "type": "integer",
                "minimum": 1
              },
              "changes": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "account_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "partner_id": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "minimum": 1
                  },
                  "debit": {
                    "type": "string",
                    "maxLength": 256,
                    "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
                  },
                  "credit": {
                    "type": "string",
                    "maxLength": 256,
                    "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
                  },
                  "date_maturity": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date"
                  },
                  "analytic_distribution": {
                    "$ref": "invoice.lines.replace.request.schema.json#/$defs/invoice_line/properties/analytic_distribution"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
