{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/bank.statement.create.request.schema.json",
  "title": "bank.statement.create request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "context", "parameters"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
    "context": {"$ref": "request.schema.json#/$defs/context"},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transaction_ids", "reference", "balance_end_real"],
      "properties": {
        "transaction_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1},
          "description": "Unique transaction IDs; the public contract normalizes them to ascending order."
        },
        "reference": {"$ref": "#/$defs/nullableText"},
        "balance_end_real": {"$ref": "#/$defs/signedDecimal"}
      }
    }
  },
  "$defs": {
    "nullableText": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$(?![\\s\\S])"}
      ]
    },
    "signedDecimal": {"type": "string", "maxLength": 256, "pattern": "^(?:0|-?(?:0\\.[0-9]*[1-9]|[1-9][0-9]*(?:\\.[0-9]*[1-9])?))$(?![\\s\\S])"}
  }
}
