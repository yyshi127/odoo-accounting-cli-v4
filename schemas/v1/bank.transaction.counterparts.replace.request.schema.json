{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/bank.transaction.counterparts.replace.request.schema.json",
  "title": "bank.transaction.counterparts.replace request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "context", "parameters"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
    "context": {"$ref": "request.schema.json#/$defs/context"},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transaction_id", "lines"],
      "properties": {
        "transaction_id": {"type": "integer", "minimum": 1},
        "lines": {
          "type": "array", "minItems": 2, "maxItems": 100,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["account_id", "label", "balance"],
            "properties": {
              "account_id": {"type": "integer", "minimum": 1},
              "label": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$(?![\\s\\S])"},
              "balance": {"type": "string", "maxLength": 256, "pattern": "^-?(?:0\\.[0-9]*[1-9]|[1-9][0-9]*(?:\\.[0-9]*[1-9])?)$(?![\\s\\S])"}
            }
          }
        }
      }
    }
  }
}
