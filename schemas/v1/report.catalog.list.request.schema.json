{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/report.catalog.list.request.schema.json",
  "title": "report.catalog.list request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "context", "parameters"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
    "context": {"$ref": "request.schema.json#/$defs/context"},
    "parameters": {"$ref": "#/$defs/parameters"}
  },
  "$defs": {
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "country_id": {"type": ["integer", "null"], "minimum": 1, "default": null},
        "root_report_id": {"type": ["integer", "null"], "minimum": 1, "default": null},
        "availability_conditions": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["country", "coa", "always"]}}], "default": null},
        "active": {"type": ["boolean", "null"], "default": null},
        "limit": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 100},
        "cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096, "default": null}
      }
    }
  }
}
