{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/invoice.line.update.request.schema.json",
  "title": "invoice.line.update request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "context", "parameters"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
    "context": {"$ref": "request.schema.json#/$defs/context"},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["move_id", "line_id", "changes"],
      "properties": {
        "move_id": {"type": "integer", "minimum": 1},
        "line_id": {"type": "integer", "minimum": 1},
        "changes": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "name": {"$ref": "invoice.lines.replace.request.schema.json#/$defs/invoice_line/properties/name"},
            "product_id": {"$ref": "invoice.lines.replace.request.schema.json#/$defs/invoice_line/properties/product_id"},
            "product_uom_id": {"$ref": "invoice.lines.replace.request.schema.json#/$defs/invoice_line/properties/product_uom_id"},
            "deductible_amount": {"$ref": "invoice.lines.replace.request.schema.json#/$defs/invoice_line/properties/deductible_amount"},
            "account_id": {"$ref": "invoice.lines.replace.request.schema.json#/$defs/invoice_line/properties/account_id"},
            "quantity": {"$ref": "invoice.lines.replace.request.schema.json#/$defs/invoice_line/properties/quantity"},
            "price_unit": {"$ref": "invoice.lines.replace.request.schema.json#/$defs/invoice_line/properties/price_unit"},
            "discount": {"$ref": "invoice.lines.replace.request.schema.json#/$defs/invoice_line/properties/discount"},
            "tax_ids": {"$ref": "invoice.lines.replace.request.schema.json#/$defs/invoice_line/properties/tax_ids"},
            "analytic_distribution": {"$ref": "invoice.lines.replace.request.schema.json#/$defs/invoice_line/properties/analytic_distribution"},
            "deferred_start_date": {"$ref": "invoice.lines.replace.request.schema.json#/$defs/invoice_line/properties/deferred_start_date"},
            "deferred_end_date": {"$ref": "invoice.lines.replace.request.schema.json#/$defs/invoice_line/properties/deferred_end_date"}
          },
          "dependentRequired": {
            "deferred_start_date": ["deferred_end_date"],
            "deferred_end_date": ["deferred_start_date"]
          },
          "allOf": [
            {
              "if": {
                "required": ["deferred_start_date"],
                "properties": {"deferred_start_date": {"type": "null"}}
              },
              "then": {"properties": {"deferred_end_date": {"type": "null"}}}
            },
            {
              "if": {
                "required": ["deferred_end_date"],
                "properties": {"deferred_end_date": {"type": "null"}}
              },
              "then": {"properties": {"deferred_start_date": {"type": "null"}}}
            },
            {
              "if": {"required": ["product_uom_id", "product_id"]},
              "then": {"properties": {"product_id": {"type": "integer", "minimum": 1}}}
            }
          ]
        }
      }
    }
  }
}
