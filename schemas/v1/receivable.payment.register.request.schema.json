{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/receivable.payment.register.request.schema.json",
  "title": "receivable.payment.register request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "context",
    "parameters"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "request_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "context": {
      "$ref": "request.schema.json#/$defs/context"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "move_id",
        "journal_id",
        "payment_date"
      ],
      "properties": {
        "move_id": {
          "type": "integer",
          "minimum": 1
        },
        "journal_id": {
          "type": "integer",
          "minimum": 1
        },
        "payment_date": {
          "type": "string",
          "format": "date"
        },
        "amount": {
          "$ref": "#/$defs/positive_canonical_decimal"
        },
        "payment_difference_handling": {
          "enum": ["open", "reconcile"]
        },
        "writeoff_account_id": {
          "type": "integer",
          "minimum": 1
        },
        "writeoff_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$(?![\\s\\S])"
        }
      },
      "if": {
        "required": ["payment_difference_handling"],
        "properties": {
          "payment_difference_handling": {"const": "reconcile"}
        }
      },
      "then": {
        "required": ["amount", "writeoff_account_id"]
      },
      "else": {
        "properties": {
          "writeoff_account_id": false,
          "writeoff_label": false
        }
      }
    }
  },
  "$defs": {
    "positive_canonical_decimal": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9])$(?![\\s\\S])"
    }
  }
}
