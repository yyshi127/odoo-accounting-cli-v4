{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/product.update.request.schema.json",
  "title": "product.update request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "context", "parameters"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
    "context": {"$ref": "request.schema.json#/$defs/context"},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_id", "changes"],
      "properties": {
        "product_id": {"type": "integer", "minimum": 1},
        "changes": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "name": {"$ref": "#/$defs/text256"},
            "default_code": {"$ref": "#/$defs/text64"},
            "product_type": {"enum": ["consu", "service"]},
            "category_id": {"type": "integer", "minimum": 1},
            "uom_id": {"type": "integer", "minimum": 1},
            "barcode": {"$ref": "#/$defs/nullableText64"},
            "sale_ok": {"type": "boolean"},
            "purchase_ok": {"type": "boolean"},
            "list_price": {"$ref": "#/$defs/nonnegativeDecimal"}
          }
        }
      }
    }
  },
  "$defs": {
    "text256": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$(?![\\s\\S])"},
    "text64": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$(?![\\s\\S])"},
    "nullableText64": {"type": ["string", "null"], "minLength": 1, "maxLength": 64, "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$(?![\\s\\S])"},
    "nonnegativeDecimal": {"type": "string", "maxLength": 256, "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]*[1-9])?$(?![\\s\\S])"}
  }
}
