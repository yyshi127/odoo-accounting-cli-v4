{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/customer_credit_note.create.request.schema.json",
  "title": "customer_credit_note.create request",
  "type": "object",
  "allOf": [
    {"$ref": "request.schema.json"},
    {
      "properties": {
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["date", "reason"],
          "oneOf": [
            {"required": ["move_id"], "properties": {"move_ids": false}},
            {"required": ["move_ids"], "properties": {"move_id": false, "lines": false}}
          ],
          "properties": {
            "move_id": {"type": "integer", "minimum": 1},
            "move_ids": {"type": "array", "minItems": 2, "maxItems": 100, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
            "date": {"type": "string", "format": "date"},
            "reason": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$"
            },
            "lines": {
              "type": "array",
              "description": "Custom refund lines may include product_uom_id and native deductible_amount percentage; full native batches do not accept custom lines.",
              "minItems": 1,
              "maxItems": 500,
              "items": {
                "$ref": "invoice.lines.replace.request.schema.json#/$defs/invoice_line"
              }
            }
          }
        }
      }
    }
  ]
}
