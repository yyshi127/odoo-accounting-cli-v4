{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/report.external_value.search.response.schema.json",
  "title": "report.external_value.search response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "success", "capability", "status", "data", "warnings", "error", "odoo", "audit"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": ["string", "null"], "format": "uuid"},
    "success": {"type": "boolean"},
    "capability": {"const": "report.external_value.search"},
    "status": {"type": "string", "minLength": 1},
    "data": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/data"}]},
    "warnings": {"type": "array", "items": {"type": "object"}},
    "error": {"oneOf": [{"type": "null"}, {"$ref": "response.schema.json#/$defs/error"}]},
    "odoo": {"$ref": "response.schema.json#/$defs/odoo"},
    "audit": {"$ref": "response.schema.json#/$defs/audit"}
  },
  "allOf": [{"if": {"properties": {"success": {"const": true}}, "required": ["success"]}, "then": {"properties": {"request_id": {"type": "string", "format": "uuid"}, "status": {"const": "verified"}, "data": {"$ref": "#/$defs/data"}, "error": {"type": "null"}}}, "else": {"properties": {"data": {"type": "null"}, "error": {"$ref": "response.schema.json#/$defs/error"}}}}],
  "$defs": {
    "data": {
      "type": "object", "additionalProperties": false,
      "required": ["items", "has_more", "next_cursor"],
      "properties": {"items": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/item"}}, "has_more": {"type": "boolean"}, "next_cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096}},
      "allOf": [{"if": {"properties": {"has_more": {"const": true}}, "required": ["has_more"]}, "then": {"properties": {"items": {"type": "array", "minItems": 1}, "next_cursor": {"type": "string"}}}, "else": {"properties": {"next_cursor": {"type": "null"}}}}]
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "company_id", "name", "date", "value", "text_value", "report", "report_line", "expression", "carryover_origin_line", "carryover_origin_expression_label"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "company_id": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1},
        "date": {"type": "string", "format": "date"},
        "value": {"$ref": "#/$defs/decimal"},
        "text_value": {"type": ["string", "null"]},
        "report": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/named"}]},
        "report_line": {"$ref": "#/$defs/report_line"},
        "expression": {"$ref": "#/$defs/expression"},
        "carryover_origin_line": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/named"}]},
        "carryover_origin_expression_label": {"type": ["string", "null"]}
      }
    },
    "report_line": {"type": "object", "additionalProperties": false, "required": ["id", "name", "code"], "properties": {"id": {"type": "integer", "minimum": 1}, "name": {"type": "string", "minLength": 1}, "code": {"type": ["string", "null"]}}},
    "expression": {"type": "object", "additionalProperties": false, "required": ["id", "label"], "properties": {"id": {"type": "integer", "minimum": 1}, "label": {"type": "string", "minLength": 1}}},
    "named": {"type": "object", "additionalProperties": false, "required": ["id", "name"], "properties": {"id": {"type": "integer", "minimum": 1}, "name": {"type": "string", "minLength": 1}}},
    "decimal": {"type": "string", "maxLength": 256, "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"}
  }
}
