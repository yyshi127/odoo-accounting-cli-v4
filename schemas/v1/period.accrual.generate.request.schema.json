{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/period.accrual.generate.request.schema.json",
  "title": "period.accrual.generate request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "context", "parameters"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
    "context": {"$ref": "request.schema.json#/$defs/context"},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_model", "order_ids", "date", "reversal_date", "journal_id", "accrual_account_id"],
      "properties": {
        "source_model": {"enum": ["sale.order", "purchase.order"]},
        "order_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "date": {"type": "string", "format": "date"},
        "reversal_date": {"type": "string", "format": "date"},
        "journal_id": {"type": "integer", "minimum": 1},
        "accrual_account_id": {"type": "integer", "minimum": 1},
        "amount": {"$ref": "#/$defs/positive_decimal"}
      },
      "allOf": [
        {
          "if": {"required": ["amount"]},
          "then": {"properties": {"order_ids": {"maxItems": 1}}}
        }
      ]
    }
  },
  "$defs": {
    "positive_decimal": {"type": "string", "maxLength": 256, "pattern": "^(?:[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9])$(?![\\s\\S])"}
  }
}
