{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/partner.credit_limit.update.request.schema.json",
  "title": "partner.credit_limit.update request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "context",
    "parameters"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "request_id": {
      "$ref": "request.schema.json#/properties/request_id"
    },
    "context": {
      "$ref": "request.schema.json#/$defs/context"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "credit_limit",
        "partner_id"
      ],
      "properties": {
        "partner_id": {
          "type": "integer",
          "minimum": 1
        },
        "credit_limit": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$(?![\\s\\S])"
        }
      }
    }
  }
}
