{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/bank.statement.search.response.schema.json",
  "title": "bank.statement.search response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "success", "capability", "status", "data", "warnings", "error", "odoo", "audit"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": ["string", "null"], "format": "uuid"},
    "success": {"type": "boolean"},
    "capability": {"const": "bank.statement.search"},
    "status": {"type": "string", "minLength": 1},
    "data": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/data"}]},
    "warnings": {"type": "array", "items": {"type": "object"}},
    "error": {"oneOf": [{"type": "null"}, {"$ref": "response.schema.json#/$defs/error"}]},
    "odoo": {"$ref": "response.schema.json#/$defs/odoo"},
    "audit": {"$ref": "response.schema.json#/$defs/audit"}
  },
  "allOf": [{
    "if": {"properties": {"success": {"const": true}}, "required": ["success"]},
    "then": {"properties": {
      "request_id": {"type": "string", "format": "uuid"},
      "status": {"const": "verified"},
      "data": {"$ref": "#/$defs/data"},
      "error": {"type": "null"}
    }},
    "else": {"properties": {"data": {"type": "null"}, "error": {"$ref": "response.schema.json#/$defs/error"}}}
  }],
  "$defs": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "has_more", "next_cursor"],
      "properties": {
        "items": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/item"}},
        "has_more": {"type": "boolean"},
        "next_cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096}
      },
      "allOf": [{
        "if": {"properties": {"has_more": {"const": true}}, "required": ["has_more"]},
        "then": {"properties": {"items": {"type": "array", "minItems": 1}, "next_cursor": {"type": "string"}}},
        "else": {"properties": {"next_cursor": {"type": "null"}}}
      }]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "reference", "date", "company_id", "journal", "currency", "balance_start", "balance_end", "balance_end_real", "is_complete", "is_valid", "problem_description", "transaction_count"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1},
        "reference": {"type": ["string", "null"]},
        "date": {"type": ["string", "null"], "format": "date"},
        "company_id": {"type": "integer", "minimum": 1},
        "journal": {"$ref": "#/$defs/coded"},
        "currency": {"$ref": "#/$defs/currency"},
        "balance_start": {"$ref": "#/$defs/decimal"},
        "balance_end": {"$ref": "#/$defs/decimal"},
        "balance_end_real": {"$ref": "#/$defs/decimal"},
        "is_complete": {"type": "boolean"},
        "is_valid": {"type": "boolean"},
        "problem_description": {"type": ["string", "null"]},
        "transaction_count": {"type": "integer", "minimum": 0}
      }
    },
    "coded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code", "name"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "code": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "currency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "code": {"type": "string", "minLength": 1, "maxLength": 3}
      }
    },
    "decimal": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    }
  }
}
