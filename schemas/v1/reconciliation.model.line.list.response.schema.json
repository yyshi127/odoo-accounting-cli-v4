{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/reconciliation.model.line.list.response.schema.json",
  "title": "reconciliation.model.line.list response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "success", "capability", "status", "data", "warnings", "error", "odoo", "audit"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": ["string", "null"], "format": "uuid"},
    "success": {"type": "boolean"},
    "capability": {"const": "reconciliation.model.line.list"},
    "status": {"type": "string", "minLength": 1},
    "data": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/data"}]},
    "warnings": {"type": "array", "items": {"type": "object"}},
    "error": {"oneOf": [{"type": "null"}, {"$ref": "response.schema.json#/$defs/error"}]},
    "odoo": {"$ref": "response.schema.json#/$defs/odoo"},
    "audit": {"$ref": "response.schema.json#/$defs/audit"}
  },
  "allOf": [{"if": {"properties": {"success": {"const": true}}, "required": ["success"]}, "then": {"properties": {"request_id": {"type": "string", "format": "uuid"}, "status": {"const": "verified"}, "data": {"$ref": "#/$defs/data"}, "error": {"type": "null"}}}, "else": {"properties": {"data": {"type": "null"}, "error": {"$ref": "response.schema.json#/$defs/error"}}}}],
  "$defs": {
    "data": {
      "type": "object", "additionalProperties": false,
      "required": ["items", "has_more", "next_cursor"],
      "properties": {"items": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/item"}}, "has_more": {"type": "boolean"}, "next_cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096}},
      "allOf": [{"if": {"properties": {"has_more": {"const": true}}, "required": ["has_more"]}, "then": {"properties": {"items": {"type": "array", "minItems": 1}, "next_cursor": {"type": "string"}}}, "else": {"properties": {"next_cursor": {"type": "null"}}}}]
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sequence", "company_id", "reconciliation_model", "account", "partner", "label", "amount_type", "amount", "amount_string", "taxes", "analytic_distribution"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "sequence": {"type": "integer"},
        "company_id": {"type": "integer", "minimum": 1},
        "reconciliation_model": {"$ref": "#/$defs/named"},
        "account": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/coded"}]},
        "partner": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/named"}]},
        "label": {"type": ["string", "null"]},
        "amount_type": {"enum": ["fixed", "percentage", "percentage_st_line", "regex"]},
        "amount": {"$ref": "#/$defs/decimal"},
        "amount_string": {"type": "string", "minLength": 1},
        "taxes": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/named"}},
        "analytic_distribution": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/analytic_distribution"}}
      }
    },
    "analytic_distribution": {
      "type": "object", "additionalProperties": false,
      "required": ["analytic_accounts", "percentage"],
      "properties": {
        "analytic_accounts": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/named"}},
        "percentage": {"$ref": "#/$defs/decimal"}
      }
    },
    "named": {"type": "object", "additionalProperties": false, "required": ["id", "name"], "properties": {"id": {"type": "integer", "minimum": 1}, "name": {"type": "string", "minLength": 1}}},
    "coded": {"type": "object", "additionalProperties": false, "required": ["id", "code", "name"], "properties": {"id": {"type": "integer", "minimum": 1}, "code": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}}},
    "decimal": {"type": "string", "maxLength": 256, "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"}
  }
}
