{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/payment.reset_to_draft.request.schema.json",
  "title": "payment.reset_to_draft request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "context", "parameters"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
    "context": {"$ref": "request.schema.json#/$defs/context"},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "payment_id": {"type": "integer", "minimum": 1},
        "payment_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        }
      },
      "oneOf": [
        {"required": ["payment_id"]},
        {"required": ["payment_ids"]}
      ]
    }
  }
}
