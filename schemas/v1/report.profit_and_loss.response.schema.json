{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/report.profit_and_loss.response.schema.json",
  "title": "report.profit_and_loss response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "success", "capability", "status", "data", "warnings", "error", "odoo", "audit"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": ["string", "null"], "format": "uuid"},
    "success": {"type": "boolean"},
    "capability": {"const": "report.profit_and_loss"},
    "status": {"type": "string", "minLength": 1},
    "data": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/data"}]},
    "warnings": {"type": "array", "items": {"type": "object"}},
    "error": {"oneOf": [{"type": "null"}, {"$ref": "response.schema.json#/$defs/error"}]},
    "odoo": {"$ref": "response.schema.json#/$defs/odoo"},
    "audit": {"$ref": "response.schema.json#/$defs/audit"}
  },
  "allOf": [{
    "if": {"properties": {"success": {"const": true}}, "required": ["success"]},
    "then": {"properties": {"request_id": {"type": "string", "format": "uuid"}, "status": {"const": "verified"}, "data": {"$ref": "#/$defs/data"}, "error": {"type": "null"}}},
    "else": {"properties": {"data": {"type": "null"}, "error": {"$ref": "response.schema.json#/$defs/error"}}}
  }],
  "$defs": {
    "decimal": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "report": {"type": "object", "additionalProperties": false, "required": ["key", "name"], "properties": {"key": {"const": "profit_and_loss"}, "name": {"type": "string", "minLength": 1}}},
    "date": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"type": "string", "format": "date"}, "to": {"type": "string", "format": "date"}}},
    "currency": {"type": "object", "additionalProperties": false, "required": ["id", "code", "decimal_places"], "properties": {"id": {"type": "integer", "minimum": 1}, "code": {"type": "string", "minLength": 1, "maxLength": 3}, "decimal_places": {"type": "integer", "minimum": 0}}},
    "column": {"type": "object", "additionalProperties": false, "required": ["index", "label", "expression_label"], "properties": {"index": {"type": "integer", "minimum": 0}, "label": {"type": "string", "minLength": 1}, "expression_label": {"type": "string", "minLength": 1}}},
    "line": {"type": "object", "additionalProperties": false, "required": ["id", "parent_id", "name", "level", "unfoldable", "values"], "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 4096}, "parent_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096}, "name": {"type": "string", "minLength": 1}, "level": {"type": "integer", "minimum": 0}, "unfoldable": {"type": "boolean"}, "values": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/decimal"}]}}}},
    "data": {"type": "object", "additionalProperties": false, "required": ["report", "date", "currency", "basis", "columns", "lines", "has_more", "next_cursor"], "properties": {"report": {"$ref": "#/$defs/report"}, "date": {"$ref": "#/$defs/date"}, "currency": {"$ref": "#/$defs/currency"}, "basis": {"const": "posted_entries"}, "columns": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/column"}}, "lines": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/line"}}, "has_more": {"type": "boolean"}, "next_cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096}}}
  }
}
