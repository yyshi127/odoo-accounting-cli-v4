{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/journal_entry.update.response.schema.json",
  "title": "journal_entry.update response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "success",
    "capability",
    "status",
    "data",
    "warnings",
    "error",
    "odoo",
    "audit"
  ],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": ["string", "null"], "format": "uuid"},
    "success": {"type": "boolean"},
    "capability": {"const": "journal_entry.update"},
    "status": {"type": "string", "minLength": 1},
    "data": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "core-write-result.schema.json"}
      ]
    },
    "warnings": {"type": "array", "items": {"type": "object"}},
    "error": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "response.schema.json#/$defs/error"}
      ]
    },
    "odoo": {"$ref": "response.schema.json#/$defs/odoo"},
    "audit": {"$ref": "response.schema.json#/$defs/audit"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"success": {"const": true}},
        "required": ["success"]
      },
      "then": {
        "properties": {
          "request_id": {"type": "string", "format": "uuid"},
          "status": {"const": "verified"},
          "data": {"$ref": "core-write-result.schema.json"},
          "error": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "data": {"type": "null"},
          "error": {"$ref": "response.schema.json#/$defs/error"}
        }
      }
    }
  ]
}
