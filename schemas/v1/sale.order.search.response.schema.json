{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/sale.order.search.response.schema.json",
  "title": "sale.order.search response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "success", "capability", "status", "data", "warnings", "error", "odoo", "audit"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": ["string", "null"], "format": "uuid"},
    "success": {"type": "boolean"},
    "capability": {"const": "sale.order.search"},
    "status": {"type": "string", "minLength": 1},
    "data": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/page"}]},
    "warnings": {"type": "array", "items": {"type": "object"}},
    "error": {"oneOf": [{"type": "null"}, {"$ref": "response.schema.json#/$defs/error"}]},
    "odoo": {"$ref": "response.schema.json#/$defs/odoo"},
    "audit": {"$ref": "response.schema.json#/$defs/audit"}
  },
  "allOf": [{"if": {"properties": {"success": {"const": true}}, "required": ["success"]}, "then": {"properties": {"request_id": {"type": "string", "format": "uuid"}, "status": {"const": "verified"}, "data": {"$ref": "#/$defs/page"}, "error": {"type": "null"}}}, "else": {"properties": {"data": {"type": "null"}, "error": {"$ref": "response.schema.json#/$defs/error"}}}}],
  "$defs": {
    "ref": {"type": "object", "additionalProperties": false, "required": ["id", "name"], "properties": {"id": {"type": "integer", "minimum": 1}, "name": {"type": "string", "minLength": 1}}},
    "nullableRef": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/ref"}]},
    "currency": {"type": "object", "additionalProperties": false, "required": ["id", "code"], "properties": {"id": {"type": "integer", "minimum": 1}, "code": {"type": "string", "minLength": 1, "maxLength": 3}}},
    "decimal": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
    "utcDateTime": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "nullableDate": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date"}]},
    "nullableText": {"type": ["string", "null"], "minLength": 1},
    "idList": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "company", "partner", "state", "date_order", "currency", "user", "invoice_status", "amount_untaxed", "amount_tax", "amount_total", "invoice_ids", "transfer_ids", "line_count", "validity_date", "client_order_ref", "team", "delivery_status"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1},
        "company": {"$ref": "#/$defs/ref"},
        "partner": {"$ref": "#/$defs/ref"},
        "state": {"enum": ["draft", "sent", "sale", "cancel"]},
        "date_order": {"$ref": "#/$defs/utcDateTime"},
        "currency": {"$ref": "#/$defs/currency"},
        "user": {"$ref": "#/$defs/nullableRef"},
        "invoice_status": {"enum": ["upselling", "invoiced", "to invoice", "no"]},
        "amount_untaxed": {"$ref": "#/$defs/decimal"},
        "amount_tax": {"$ref": "#/$defs/decimal"},
        "amount_total": {"$ref": "#/$defs/decimal"},
        "invoice_ids": {"$ref": "#/$defs/idList"},
        "transfer_ids": {"$ref": "#/$defs/idList"},
        "line_count": {"type": "integer", "minimum": 0},
        "validity_date": {"$ref": "#/$defs/nullableDate"},
        "client_order_ref": {"$ref": "#/$defs/nullableText"},
        "team": {"$ref": "#/$defs/nullableRef"},
        "delivery_status": {"type": ["string", "null"], "enum": ["pending", "started", "partial", "full", null]}
      }
    },
    "page": {"type": "object", "additionalProperties": false, "required": ["items", "has_more", "next_cursor"], "properties": {"items": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/header"}}, "has_more": {"type": "boolean"}, "next_cursor": {"type": ["string", "null"], "minLength": 1}}}
  }
}
