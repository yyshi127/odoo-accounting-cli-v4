{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/invoice.type.switch.request.schema.json",
  "title": "invoice.type.switch request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "context", "parameters"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
    "context": {"$ref": "request.schema.json#/$defs/context"},
    "parameters": {
      "type": "object", "additionalProperties": false,
      "required": ["move_id", "target_move_type"],
      "properties": {
        "move_id": {"type": "integer", "minimum": 1},
        "target_move_type": {"enum": ["out_invoice", "out_refund", "in_invoice", "in_refund"]}
      }
    }
  }
}
