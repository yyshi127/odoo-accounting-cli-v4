{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/tax.repartition_line.update.request.schema.json",
  "title": "tax.repartition_line.update request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "context",
    "parameters"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "request_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "context": {
      "$ref": "request.schema.json#/$defs/context"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tax_id": {
          "type": "integer",
          "minimum": 1
        },
        "line_id": {
          "type": "integer",
          "minimum": 1
        },
        "changes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sequence": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            "repartition_type": {
              "enum": [
                "base",
                "tax"
              ]
            },
            "factor_percent": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,12}0*)?$(?![\\s\\S])"
            },
            "account_id": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "tag_ids": {
              "type": "array",
              "maxItems": 100,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            },
            "use_in_tax_closing": {
              "type": "boolean"
            }
          },
          "required": [],
          "minProperties": 1
        }
      },
      "required": [
        "changes",
        "line_id",
        "tax_id"
      ]
    }
  }
}
