{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/vendor_bill.create.request.schema.json",
  "title": "vendor_bill.create request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "context",
    "parameters"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "request_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "context": {
      "$ref": "request.schema.json#/$defs/context"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partner_id",
        "journal_id",
        "invoice_date",
        "currency_id",
        "lines"
      ],
      "properties": {
        "partner_id": {
          "type": "integer",
          "minimum": 1
        },
        "journal_id": {
          "type": "integer",
          "minimum": 1
        },
        "invoice_date": {
          "type": "string",
          "format": "date"
        },
        "invoice_date_due": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "payment_term_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "reference": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        },
        "payment_reference": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        },
        "currency_id": {
          "type": "integer",
          "minimum": 1
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "account_id",
              "quantity",
              "price_unit",
              "tax_ids"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$"
              },
              "account_id": {
                "type": "integer",
                "minimum": 1
              },
              "product_id": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "quantity": {
                "$ref": "#/$defs/positive_decimal"
              },
              "price_unit": {
                "$ref": "#/$defs/decimal"
              },
              "discount": {
                "$ref": "#/$defs/percentage_decimal"
              },
              "tax_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "analytic_distribution": {
                "$ref": "invoice.lines.replace.request.schema.json#/$defs/analytic_distribution"
              },
              "deferred_start_date": {
                "type": ["string", "null"],
                "format": "date"
              },
              "deferred_end_date": {
                "type": ["string", "null"],
                "format": "date"
              }
            },
            "dependentRequired": {
              "deferred_start_date": ["deferred_end_date"],
              "deferred_end_date": ["deferred_start_date"]
            },
            "oneOf": [
              {
                "properties": {
                  "deferred_start_date": {"type": "null"},
                  "deferred_end_date": {"type": "null"}
                }
              },
              {
                "required": ["deferred_start_date", "deferred_end_date"],
                "properties": {
                  "deferred_start_date": {"type": "string"},
                  "deferred_end_date": {"type": "string"}
                }
              }
            ]
          }
        }
      },
      "not": {
        "required": [
          "invoice_date_due",
          "payment_term_id"
        ],
        "properties": {
          "invoice_date_due": {
            "type": "string"
          },
          "payment_term_id": {
            "type": "integer"
          }
        }
      }
    }
  },
  "$defs": {
    "decimal": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$(?![\\s\\S])"
    },
    "positive_decimal": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(?:(?:[1-9][0-9]*)(?:\\.[0-9]+)?|0\\.(?=[0-9]*[1-9])[0-9]+)$(?![\\s\\S])"
    },
    "percentage_decimal": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(?:100(?:\\.0+)?|(?:[0-9]|[1-9][0-9])(?:\\.[0-9]+)?)$(?![\\s\\S])"
    }
  }
}
