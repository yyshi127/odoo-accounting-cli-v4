{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/report.budget.response.schema.json",
  "title": "report.budget response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "success", "capability", "status", "data", "warnings", "error", "odoo", "audit"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": ["string", "null"], "format": "uuid"},
    "success": {"type": "boolean"},
    "capability": {"const": "report.budget"},
    "status": {"type": "string", "minLength": 1},
    "data": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/data"}]},
    "warnings": {"type": "array", "items": {"type": "object"}},
    "error": {"oneOf": [{"type": "null"}, {"$ref": "response.schema.json#/$defs/error"}]},
    "odoo": {"$ref": "response.schema.json#/$defs/odoo"},
    "audit": {"$ref": "response.schema.json#/$defs/audit"}
  },
  "allOf": [{
    "if": {"properties": {"success": {"const": true}}, "required": ["success"]},
    "then": {"properties": {
      "request_id": {"type": "string", "format": "uuid"},
      "status": {"const": "verified"},
      "data": {"$ref": "#/$defs/data"},
      "error": {"type": "null"}
    }},
    "else": {"properties": {"data": {"type": "null"}, "error": {"$ref": "response.schema.json#/$defs/error"}}}
  }],
  "$defs": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "has_more", "next_cursor"],
      "properties": {
        "items": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/item"}},
        "has_more": {"type": "boolean"},
        "next_cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096}
      },
      "allOf": [{
        "if": {"properties": {"has_more": {"const": true}}, "required": ["has_more"]},
        "then": {"properties": {"items": {"type": "array", "minItems": 1}, "next_cursor": {"type": "string"}}},
        "else": {"properties": {"next_cursor": {"type": "null"}}}
      }]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_key", "line_type", "date", "budget", "budget_line", "source", "description", "plan_accounts", "company_id", "user", "budget_amount", "achieved_amount", "theoretical_amount"],
      "properties": {
        "row_key": {"type": "string", "minLength": 1},
        "line_type": {"enum": ["budget", "achieved"]},
        "date": {"type": "string", "format": "date"},
        "budget": {"$ref": "#/$defs/named"},
        "budget_line": {"$ref": "#/$defs/id_ref"},
        "source": {"$ref": "#/$defs/source"},
        "description": {"type": ["string", "null"]},
        "plan_accounts": {"type": "array", "items": {"$ref": "#/$defs/plan_account"}},
        "company_id": {"type": ["integer", "null"], "minimum": 1},
        "user": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/named"}]},
        "budget_amount": {"$ref": "#/$defs/decimal"},
        "achieved_amount": {"$ref": "#/$defs/decimal"},
        "theoretical_amount": {"$ref": "#/$defs/decimal"}
      }
    },
    "id_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {"id": {"type": "integer", "minimum": 1}}
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "id"],
      "properties": {
        "model": {"enum": ["budget.analytic", "account.analytic.line"]},
        "id": {"type": "integer", "minimum": 1}
      }
    },
    "plan_account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "account"],
      "properties": {
        "plan": {"$ref": "#/$defs/named"},
        "account": {"$ref": "#/$defs/named"}
      }
    },
    "named": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "decimal": {"type": "string", "maxLength": 256, "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"}
  }
}
