{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/currency.rate.list.response.schema.json",
  "title": "currency.rate.list response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "success", "capability", "status", "data", "warnings", "error", "odoo", "audit"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": ["string", "null"], "format": "uuid"},
    "success": {"type": "boolean"},
    "capability": {"const": "currency.rate.list"},
    "status": {"type": "string", "minLength": 1},
    "data": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/data"}]},
    "warnings": {"type": "array", "items": {"type": "object"}},
    "error": {"oneOf": [{"type": "null"}, {"$ref": "response.schema.json#/$defs/error"}]},
    "odoo": {"$ref": "response.schema.json#/$defs/odoo"},
    "audit": {"$ref": "response.schema.json#/$defs/audit"}
  },
  "allOf": [{
    "if": {"properties": {"success": {"const": true}}, "required": ["success"]},
    "then": {
      "properties": {
        "request_id": {"type": "string", "format": "uuid"},
        "status": {"const": "verified"},
        "data": {"$ref": "#/$defs/data"},
        "error": {"type": "null"}
      }
    },
    "else": {
      "properties": {
        "data": {"type": "null"},
        "error": {"$ref": "response.schema.json#/$defs/error"}
      }
    }
  }],
  "$defs": {
    "positiveDecimal": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(?:(?:[1-9][0-9]*)(?:\\.[0-9]+)?|0\\.(?=[0-9]*[1-9])[0-9]+)$(?![\\s\\S])"
    },
    "currency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "code": {"type": "string", "minLength": 1, "maxLength": 3}
      }
    },
    "item": {
      "description": "A raw Odoo rate record. It is not a ledger or multicurrency balance.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "date", "currency", "company_currency", "requested_company_id",
        "source_company_id", "technical_rate", "foreign_units_per_company_unit",
        "company_units_per_foreign_unit"
      ],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "date": {"type": "string", "format": "date"},
        "currency": {"$ref": "#/$defs/currency"},
        "company_currency": {"$ref": "#/$defs/currency"},
        "requested_company_id": {"type": "integer", "minimum": 1},
        "source_company_id": {"type": ["integer", "null"], "minimum": 1},
        "technical_rate": {
          "description": "The Odoo res.currency.rate technical rate field; no balance or quote-direction equivalence is implied.",
          "$ref": "#/$defs/positiveDecimal"
        },
        "foreign_units_per_company_unit": {
          "description": "Odoo company_rate: units of the rate currency per one company-currency unit.",
          "$ref": "#/$defs/positiveDecimal"
        },
        "company_units_per_foreign_unit": {
          "description": "Odoo inverse_company_rate: company-currency units per one rate-currency unit.",
          "$ref": "#/$defs/positiveDecimal"
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "has_more", "next_cursor"],
      "properties": {
        "items": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/item"}},
        "has_more": {"type": "boolean"},
        "next_cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096}
      },
      "allOf": [{
        "if": {"properties": {"has_more": {"const": true}}, "required": ["has_more"]},
        "then": {
          "properties": {
            "items": {"type": "array", "minItems": 1},
            "next_cursor": {"type": "string"}
          }
        },
        "else": {"properties": {"next_cursor": {"type": "null"}}}
      }]
    }
  }
}
