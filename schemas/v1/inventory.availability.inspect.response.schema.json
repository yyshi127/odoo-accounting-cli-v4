{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/inventory.availability.inspect.response.schema.json",
  "title": "inventory.availability.inspect response",
  "type": "object",
  "allOf": [
    {"$ref": "response.schema.json"},
    {
      "properties": {"capability": {"const": "inventory.availability.inspect"}, "data": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/data"}]}},
      "allOf": [{"if": {"properties": {"success": {"const": true}}, "required": ["success"]}, "then": {"properties": {"request_id": {"type": "string", "format": "uuid"}, "status": {"const": "verified"}, "data": {"$ref": "#/$defs/data"}, "error": {"type": "null"}}}, "else": {"properties": {"data": {"type": "null"}, "error": {"$ref": "response.schema.json#/$defs/error"}}}}]
    }
  ],
  "$defs": {
    "decimal": {"type": "string", "maxLength": 256, "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$(?![\\s\\S])"},
    "namedRef": {"type": "object", "additionalProperties": false, "required": ["id", "name"], "properties": {"id": {"type": "integer", "minimum": 1}, "name": {"type": "string", "minLength": 1}}},
    "codedRef": {"type": "object", "additionalProperties": false, "required": ["id", "code", "name"], "properties": {"id": {"type": "integer", "minimum": 1}, "code": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}}},
    "productRef": {"type": "object", "additionalProperties": false, "required": ["id", "code", "name"], "properties": {"id": {"type": "integer", "minimum": 1}, "code": {"type": ["string", "null"], "minLength": 1}, "name": {"type": "string", "minLength": 1}}},
    "data": {
      "type": "object", "additionalProperties": false,
      "required": ["company_id", "product", "warehouse", "location", "uom", "on_hand_quantity", "free_quantity", "incoming_quantity", "outgoing_quantity", "forecast_quantity"],
      "properties": {
        "company_id": {"type": "integer", "minimum": 1}, "product": {"$ref": "#/$defs/productRef"}, "warehouse": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/codedRef"}]}, "location": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/namedRef"}]}, "uom": {"$ref": "#/$defs/namedRef"},
        "on_hand_quantity": {"$ref": "#/$defs/decimal"}, "free_quantity": {"$ref": "#/$defs/decimal"}, "incoming_quantity": {"$ref": "#/$defs/decimal"}, "outgoing_quantity": {"$ref": "#/$defs/decimal"}, "forecast_quantity": {"$ref": "#/$defs/decimal"}
      }
    }
  }
}
