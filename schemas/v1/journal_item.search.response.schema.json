{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/journal_item.search.response.schema.json",
  "title": "journal_item.search response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "success",
    "capability",
    "status",
    "data",
    "warnings",
    "error",
    "odoo",
    "audit"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "success": {
      "type": "boolean"
    },
    "capability": {
      "const": "journal_item.search"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/data"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "response.schema.json#/$defs/error"
        }
      ]
    },
    "odoo": {
      "$ref": "response.schema.json#/$defs/odoo"
    },
    "audit": {
      "$ref": "response.schema.json#/$defs/audit"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "success": {
            "const": true
          }
        },
        "required": [
          "success"
        ]
      },
      "then": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "const": "verified"
          },
          "data": {
            "$ref": "#/$defs/data"
          },
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "data": {
            "type": "null"
          },
          "error": {
            "$ref": "response.schema.json#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "has_more",
        "next_cursor"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "has_more": {
          "type": "boolean"
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "has_more": {
                "const": true
              }
            },
            "required": [
              "has_more"
            ]
          },
          "then": {
            "properties": {
              "items": {
                "type": "array",
                "minItems": 1
              },
              "next_cursor": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "next_cursor": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "company_id",
        "date",
        "date_maturity",
        "move",
        "account",
        "partner",
        "journal",
        "name",
        "reference",
        "debit",
        "credit",
        "balance",
        "amount_currency",
        "currency",
        "reconciled",
        "matching_number"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "company_id": {
          "type": "integer",
          "minimum": 1
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "date_maturity": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date"
            }
          ]
        },
        "move": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "state",
            "move_type"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "state": {
              "enum": [
                "draft",
                "posted",
                "cancel"
              ]
            },
            "move_type": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "account": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "code",
            "name"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "code": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "partner": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "journal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "code",
            "name"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "code": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "name": {
          "type": "string"
        },
        "reference": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "debit": {
          "$ref": "#/$defs/decimal"
        },
        "credit": {
          "$ref": "#/$defs/decimal"
        },
        "balance": {
          "$ref": "#/$defs/decimal"
        },
        "amount_currency": {
          "$ref": "#/$defs/decimal"
        },
        "currency": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "code"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 3
            }
          }
        },
        "reconciled": {
          "type": "boolean"
        },
        "matching_number": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        }
      }
    },
    "decimal": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    }
  }
}
