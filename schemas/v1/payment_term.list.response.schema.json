{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/payment_term.list.response.schema.json",
  "title": "payment_term.list response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "success", "capability", "status", "data", "warnings", "error", "odoo", "audit"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": ["string", "null"], "format": "uuid"},
    "success": {"type": "boolean"},
    "capability": {"const": "payment_term.list"},
    "status": {"type": "string", "minLength": 1},
    "data": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/data"}]},
    "warnings": {"type": "array", "items": {"type": "object"}},
    "error": {"oneOf": [{"type": "null"}, {"$ref": "response.schema.json#/$defs/error"}]},
    "odoo": {"$ref": "response.schema.json#/$defs/odoo"},
    "audit": {"$ref": "response.schema.json#/$defs/audit"}
  },
  "allOf": [{
    "if": {"properties": {"success": {"const": true}}, "required": ["success"]},
    "then": {
      "properties": {
        "request_id": {"type": "string", "format": "uuid"},
        "status": {"const": "verified"},
        "data": {"$ref": "#/$defs/data"},
        "error": {"type": "null"}
      }
    },
    "else": {
      "properties": {
        "data": {"type": "null"},
        "error": {"$ref": "response.schema.json#/$defs/error"}
      }
    }
  }],
  "$defs": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "has_more", "next_cursor"],
      "properties": {
        "items": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/item"}},
        "has_more": {"type": "boolean"},
        "next_cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096}
      }
    },
    "decimal": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "value", "value_amount", "delay_type", "nb_days", "days_next_month"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "value": {"enum": ["percent", "fixed"]},
        "value_amount": {"$ref": "#/$defs/decimal"},
        "delay_type": {"enum": ["days_after", "days_after_end_of_month", "days_after_end_of_next_month", "days_end_of_month_on_the"]},
        "nb_days": {"type": "integer"},
        "days_next_month": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^(?:[0-9]|[12][0-9]|3[01])$"}
          ]
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sequence", "name", "active", "company_id", "display_on_invoice", "early_discount", "discount_percentage", "discount_days", "early_pay_discount_computation", "lines"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "sequence": {"type": "integer"},
        "name": {"type": "string", "minLength": 1},
        "active": {"type": "boolean"},
        "company_id": {"type": ["integer", "null"], "minimum": 1},
        "display_on_invoice": {"type": "boolean"},
        "early_discount": {"type": "boolean"},
        "discount_percentage": {"$ref": "#/$defs/decimal"},
        "discount_days": {"type": "integer"},
        "early_pay_discount_computation": {"enum": ["included", "excluded", "mixed"]},
        "lines": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/line"}}
      }
    }
  }
}
