{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/stock.move.search.response.schema.json",
  "title": "stock.move.search response",
  "type": "object",
  "allOf": [
    {"$ref": "response.schema.json"},
    {
      "properties": {"capability": {"const": "stock.move.search"}, "data": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/data"}]}},
      "allOf": [{"if": {"properties": {"success": {"const": true}}, "required": ["success"]}, "then": {"properties": {"request_id": {"type": "string", "format": "uuid"}, "status": {"const": "verified"}, "data": {"$ref": "#/$defs/data"}, "error": {"type": "null"}}}, "else": {"properties": {"data": {"type": "null"}, "error": {"$ref": "response.schema.json#/$defs/error"}}}}]
    }
  ],
  "$defs": {
    "decimal": {"type": "string", "maxLength": 256, "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$(?![\\s\\S])"},
    "nullableText": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
    "namedRef": {"type": "object", "additionalProperties": false, "required": ["id", "name"], "properties": {"id": {"type": "integer", "minimum": 1}, "name": {"type": "string", "minLength": 1}}},
    "productRef": {"type": "object", "additionalProperties": false, "required": ["id", "code", "name"], "properties": {"id": {"type": "integer", "minimum": 1}, "code": {"$ref": "#/$defs/nullableText"}, "name": {"type": "string", "minLength": 1}}},
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "company_id", "reference", "description_picking", "state", "date", "transfer", "product", "uom", "demand_quantity", "moved_quantity", "source_location", "destination_location"],
      "properties": {
        "id": {"type": "integer", "minimum": 1}, "company_id": {"type": "integer", "minimum": 1}, "reference": {"$ref": "#/$defs/nullableText"}, "description_picking": {"$ref": "#/$defs/nullableText"},
        "state": {"enum": ["draft", "waiting", "confirmed", "partially_available", "assigned", "done", "cancel"]},
        "date": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "transfer": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/namedRef"}]}, "product": {"$ref": "#/$defs/productRef"}, "uom": {"$ref": "#/$defs/namedRef"},
        "demand_quantity": {"$ref": "#/$defs/decimal"}, "moved_quantity": {"$ref": "#/$defs/decimal"},
        "source_location": {"$ref": "#/$defs/namedRef"}, "destination_location": {"$ref": "#/$defs/namedRef"}
      }
    },
    "data": {
      "type": "object", "additionalProperties": false, "required": ["items", "has_more", "next_cursor"],
      "properties": {"items": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/item"}}, "has_more": {"type": "boolean"}, "next_cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096}},
      "allOf": [{"if": {"properties": {"has_more": {"const": true}}, "required": ["has_more"]}, "then": {"properties": {"items": {"type": "array", "minItems": 1}, "next_cursor": {"type": "string"}}}, "else": {"properties": {"next_cursor": {"type": "null"}}}}]
    }
  }
}
