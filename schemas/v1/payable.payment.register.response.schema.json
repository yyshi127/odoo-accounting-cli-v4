{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/payable.payment.register.response.schema.json",
  "title": "payable.payment.register response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "success",
    "capability",
    "status",
    "data",
    "warnings",
    "error",
    "odoo",
    "audit"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "success": {
      "type": "boolean"
    },
    "capability": {
      "const": "payable.payment.register"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "core-write-result.schema.json"
        },
        {
          "$ref": "#/$defs/payment_batch"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "response.schema.json#/$defs/error"
        }
      ]
    },
    "odoo": {
      "$ref": "response.schema.json#/$defs/odoo"
    },
    "audit": {
      "$ref": "response.schema.json#/$defs/audit"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "success": {
            "const": true
          }
        },
        "required": [
          "success"
        ]
      },
      "then": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "const": "verified"
          },
          "data": {
            "oneOf": [{"$ref": "core-write-result.schema.json"}, {"$ref": "#/$defs/payment_batch"}]
          },
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "data": {
            "type": "null"
          },
          "error": {
            "$ref": "response.schema.json#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "payment_batch": {
      "type": "object", "additionalProperties": false, "required": ["idempotent_replay", "result"],
      "properties": {
        "idempotent_replay": {"type": "boolean"},
        "result": {
          "type": "object", "additionalProperties": false, "required": ["items", "processed_count"],
          "properties": {
            "items": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"allOf": [{"$ref": "core-write-result.schema.json#/properties/result"}, {"properties": {"model": {"const": "account.payment"}, "id": {"type": "integer", "minimum": 1}, "move_type": {"type": "null"}}}]}},
            "processed_count": {"type": "integer", "minimum": 1, "maximum": 1000}
          }
        }
      }
    }
  }
}
