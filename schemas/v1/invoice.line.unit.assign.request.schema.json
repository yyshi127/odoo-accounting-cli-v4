{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/invoice.line.unit.assign.request.schema.json",
  "title": "invoice.line.unit.assign request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "context",
    "parameters"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "request_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "context": {
      "$ref": "request.schema.json#/$defs/context"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "move_id",
        "line_id",
        "product_uom_id"
      ],
      "properties": {
        "move_id": {
          "type": "integer",
          "minimum": 1
        },
        "line_id": {
          "type": "integer",
          "minimum": 1
        },
        "product_uom_id": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
