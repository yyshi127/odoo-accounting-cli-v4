{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/journal_entry.search.request.schema.json",
  "title": "journal_entry.search request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "context", "parameters"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "context": {"$ref": "request.schema.json#/$defs/context"},
    "parameters": {"$ref": "#/$defs/parameters"}
  },
  "$defs": {
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limit": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 100},
        "cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096, "default": null},
        "date_from": {"type": ["string", "null"], "format": "date", "default": null},
        "date_to": {"type": ["string", "null"], "format": "date", "default": null},
        "states": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["draft", "posted", "cancel"]}
        },
        "journal_id": {"type": ["integer", "null"], "minimum": 1, "default": null},
        "partner_id": {"type": ["integer", "null"], "minimum": 1, "default": null},
        "query": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$",
          "default": null
        }
      }
    }
  }
}
