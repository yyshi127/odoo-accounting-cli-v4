{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/reconciliation.full.list.response.schema.json",
  "title": "reconciliation.full.list response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "success", "capability", "status", "data", "warnings", "error", "odoo", "audit"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": ["string", "null"], "format": "uuid"},
    "success": {"type": "boolean"},
    "capability": {"const": "reconciliation.full.list"},
    "status": {"type": "string", "minLength": 1},
    "data": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/data"}]},
    "warnings": {"type": "array", "items": {"type": "object"}},
    "error": {"oneOf": [{"type": "null"}, {"$ref": "response.schema.json#/$defs/error"}]},
    "odoo": {"$ref": "response.schema.json#/$defs/odoo"},
    "audit": {"$ref": "response.schema.json#/$defs/audit"}
  },
  "allOf": [{
    "if": {"properties": {"success": {"const": true}}, "required": ["success"]},
    "then": {"properties": {
      "request_id": {"type": "string", "format": "uuid"},
      "status": {"const": "verified"},
      "data": {"$ref": "#/$defs/data"},
      "error": {"type": "null"}
    }},
    "else": {"properties": {"data": {"type": "null"}, "error": {"$ref": "response.schema.json#/$defs/error"}}}
  }],
  "$defs": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "has_more", "next_cursor"],
      "properties": {
        "items": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/item"}},
        "has_more": {"type": "boolean"},
        "next_cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096}
      },
      "allOf": [{
        "if": {"properties": {"has_more": {"const": true}}, "required": ["has_more"]},
        "then": {"properties": {"items": {"type": "array", "minItems": 1}, "next_cursor": {"type": "string"}}},
        "else": {"properties": {"next_cursor": {"type": "null"}}}
      }]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "company_id", "matching_number", "partial_reconcile_ids", "reconciled_journal_item_ids"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "company_id": {"type": "integer", "minimum": 1},
        "matching_number": {"type": "string", "minLength": 1},
        "partial_reconcile_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "reconciled_journal_item_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
