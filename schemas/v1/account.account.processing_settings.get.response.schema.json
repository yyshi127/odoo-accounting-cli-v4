{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/account.account.processing_settings.get.response.schema.json",
  "title": "account.account.processing_settings.get response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "success",
    "capability",
    "status",
    "data",
    "warnings",
    "error",
    "odoo",
    "audit"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "success": {
      "type": "boolean"
    },
    "capability": {
      "const": "account.account.processing_settings.get"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/item"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "response.schema.json#/$defs/error"
        }
      ]
    },
    "odoo": {
      "$ref": "response.schema.json#/$defs/odoo"
    },
    "audit": {
      "$ref": "response.schema.json#/$defs/audit"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "success": {
            "const": true
          }
        },
        "required": [
          "success"
        ]
      },
      "then": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "const": "verified"
          },
          "data": {
            "$ref": "#/$defs/item"
          },
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "data": {
            "type": "null"
          },
          "error": {
            "$ref": "response.schema.json#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "company_id": {
          "type": "integer",
          "minimum": 1
        },
        "company_currency_id": {
          "type": "integer",
          "minimum": 1
        },
        "currency_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "group_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "company_ids": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "tax_ids": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "tag_ids": {
          "type": "array",
          "maxItems": 100000,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "active": {
          "type": "boolean"
        },
        "non_trade": {
          "type": "boolean"
        },
        "used": {
          "type": "boolean"
        },
        "include_initial_balance": {
          "type": "boolean"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "internal_group": {
          "enum": [
            "equity",
            "asset",
            "liability",
            "income",
            "expense",
            "off"
          ]
        },
        "related_taxes_amount": {
          "type": "integer",
          "minimum": 0
        },
        "current_balance": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$(?![\\s\\S])"
        }
      },
      "required": [
        "active",
        "company_currency_id",
        "company_id",
        "company_ids",
        "currency_id",
        "current_balance",
        "description",
        "group_id",
        "id",
        "include_initial_balance",
        "internal_group",
        "non_trade",
        "note",
        "related_taxes_amount",
        "tag_ids",
        "tax_ids",
        "used"
      ]
    }
  }
}
