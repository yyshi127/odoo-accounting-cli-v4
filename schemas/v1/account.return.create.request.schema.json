{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/account.return.create.request.schema.json",
  "title": "account.return.create request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "context", "parameters"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
    "context": {"$ref": "request.schema.json#/$defs/context"},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["return_type_id", "date_from", "date_to"],
      "properties": {
        "return_type_id": {"type": "integer", "minimum": 1},
        "date_from": {"type": "string", "format": "date", "description": "The first day of exactly one native Odoo return period for the selected standalone root company."},
        "date_to": {"type": "string", "format": "date", "description": "The last day of the same native Odoo return period; the range must not span multiple periods."}
      }
    }
  }
}
