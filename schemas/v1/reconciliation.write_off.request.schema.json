{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/reconciliation.write_off.request.schema.json",
  "title": "reconciliation.write_off request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "context", "parameters"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
    "context": {"$ref": "request.schema.json#/$defs/context"},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transaction_id", "write_off_account_id", "label", "expected_residual_amount"],
      "properties": {
        "transaction_id": {"type": "integer", "minimum": 1},
        "write_off_account_id": {"type": "integer", "minimum": 1},
        "label": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$(?![\\s\\S])"},
        "expected_residual_amount": {"type": "string", "maxLength": 256, "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$(?![\\s\\S])"}
      }
    }
  }
}
