{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/report.budget.request.schema.json",
  "title": "report.budget request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "context", "parameters"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "context": {"$ref": "request.schema.json#/$defs/context"},
    "parameters": {"$ref": "#/$defs/parameters"}
  },
  "$defs": {
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budget_id"],
      "properties": {
        "budget_id": {"type": "integer", "minimum": 1},
        "budget_line_id": {"type": ["integer", "null"], "minimum": 1, "default": null},
        "date_from": {"type": ["string", "null"], "format": "date", "default": null},
        "date_to": {"type": ["string", "null"], "format": "date", "default": null},
        "plan_id": {"type": ["integer", "null"], "minimum": 1, "default": null},
        "analytic_account_id": {"type": ["integer", "null"], "minimum": 1, "default": null},
        "line_type": {"type": ["string", "null"], "enum": ["budget", "achieved", null], "default": null},
        "limit": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 100},
        "cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096, "default": null}
      },
      "oneOf": [
        {
          "properties": {
            "plan_id": {"type": "null"},
            "analytic_account_id": {"type": "null"}
          }
        },
        {
          "required": ["plan_id", "analytic_account_id"],
          "properties": {
            "plan_id": {"type": "integer", "minimum": 1},
            "analytic_account_id": {"type": "integer", "minimum": 1}
          }
        }
      ]
    }
  }
}
