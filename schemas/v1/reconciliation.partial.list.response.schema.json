{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/reconciliation.partial.list.response.schema.json",
  "title": "reconciliation.partial.list response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "success", "capability", "status", "data", "warnings", "error", "odoo", "audit"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": ["string", "null"], "format": "uuid"},
    "success": {"type": "boolean"},
    "capability": {"const": "reconciliation.partial.list"},
    "status": {"type": "string", "minLength": 1},
    "data": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/data"}]},
    "warnings": {"type": "array", "items": {"type": "object"}},
    "error": {"oneOf": [{"type": "null"}, {"$ref": "response.schema.json#/$defs/error"}]},
    "odoo": {"$ref": "response.schema.json#/$defs/odoo"},
    "audit": {"$ref": "response.schema.json#/$defs/audit"}
  },
  "allOf": [{
    "if": {"properties": {"success": {"const": true}}, "required": ["success"]},
    "then": {"properties": {
      "request_id": {"type": "string", "format": "uuid"},
      "status": {"const": "verified"},
      "data": {"$ref": "#/$defs/data"},
      "error": {"type": "null"}
    }},
    "else": {"properties": {"data": {"type": "null"}, "error": {"$ref": "response.schema.json#/$defs/error"}}}
  }],
  "$defs": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "has_more", "next_cursor"],
      "properties": {
        "items": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/item"}},
        "has_more": {"type": "boolean"},
        "next_cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096}
      },
      "allOf": [{
        "if": {"properties": {"has_more": {"const": true}}, "required": ["has_more"]},
        "then": {"properties": {"items": {"type": "array", "minItems": 1}, "next_cursor": {"type": "string"}}},
        "else": {"properties": {"next_cursor": {"type": "null"}}}
      }]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "company_id", "max_date", "amount", "company_currency", "debit_amount_currency", "debit_currency", "credit_amount_currency", "credit_currency", "debit_journal_item_id", "credit_journal_item_id", "full_reconcile_id", "exchange_move_id", "matching_number"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "company_id": {"type": "integer", "minimum": 1},
        "max_date": {"type": "string", "format": "date"},
        "amount": {"$ref": "#/$defs/decimal"},
        "company_currency": {"$ref": "#/$defs/currency"},
        "debit_amount_currency": {"$ref": "#/$defs/decimal"},
        "debit_currency": {"$ref": "#/$defs/currency"},
        "credit_amount_currency": {"$ref": "#/$defs/decimal"},
        "credit_currency": {"$ref": "#/$defs/currency"},
        "debit_journal_item_id": {"type": "integer", "minimum": 1},
        "credit_journal_item_id": {"type": "integer", "minimum": 1},
        "full_reconcile_id": {"type": ["integer", "null"], "minimum": 1},
        "exchange_move_id": {"type": ["integer", "null"], "minimum": 1},
        "matching_number": {"type": "string", "minLength": 1}
      }
    },
    "currency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "code": {"type": "string", "minLength": 1, "maxLength": 3}
      }
    },
    "decimal": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    }
  }
}
