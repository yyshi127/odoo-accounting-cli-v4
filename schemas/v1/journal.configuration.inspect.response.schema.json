{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/journal.configuration.inspect.response.schema.json",
  "title": "journal.configuration.inspect response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "success", "capability", "status", "data", "warnings", "error", "odoo", "audit"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": ["string", "null"], "format": "uuid"},
    "success": {"type": "boolean"},
    "capability": {"const": "journal.configuration.inspect"},
    "status": {"type": "string", "minLength": 1},
    "data": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/item"}]},
    "warnings": {"type": "array", "items": {"type": "object"}},
    "error": {"oneOf": [{"type": "null"}, {"$ref": "response.schema.json#/$defs/error"}]},
    "odoo": {"$ref": "response.schema.json#/$defs/odoo"},
    "audit": {"$ref": "response.schema.json#/$defs/audit"}
  },
  "allOf": [{
    "if": {"properties": {"success": {"const": true}}, "required": ["success"]},
    "then": {"properties": {"request_id": {"type": "string", "format": "uuid"}, "status": {"const": "verified"}, "data": {"$ref": "#/$defs/item"}, "error": {"type": "null"}}},
    "else": {"properties": {"data": {"type": "null"}, "error": {"$ref": "response.schema.json#/$defs/error"}}}
  }],
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code", "name", "type", "active", "company_id", "currency", "default_account", "suspense_account", "profit_account", "loss_account", "bank_account", "inbound_payment_methods", "outbound_payment_methods", "invoice_reference_type", "invoice_reference_model", "restrict_mode_hash_table"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "code": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "type": {"type": "string", "minLength": 1},
        "active": {"type": "boolean"},
        "company_id": {"type": "integer", "minimum": 1},
        "currency": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/currency"}]},
        "default_account": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/coded"}]},
        "suspense_account": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/coded"}]},
        "profit_account": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/coded"}]},
        "loss_account": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/coded"}]},
        "bank_account": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/named"}]},
        "inbound_payment_methods": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/named"}},
        "outbound_payment_methods": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/named"}},
        "invoice_reference_type": {"enum": ["partner", "invoice"]},
        "invoice_reference_model": {"type": "string", "minLength": 1},
        "restrict_mode_hash_table": {"type": "boolean"}
      }
    },
    "named": {"type": "object", "additionalProperties": false, "required": ["id", "name"], "properties": {"id": {"type": "integer", "minimum": 1}, "name": {"type": "string", "minLength": 1}}},
    "coded": {"type": "object", "additionalProperties": false, "required": ["id", "code", "name"], "properties": {"id": {"type": "integer", "minimum": 1}, "code": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}}},
    "currency": {"type": "object", "additionalProperties": false, "required": ["id", "code"], "properties": {"id": {"type": "integer", "minimum": 1}, "code": {"type": "string", "minLength": 1, "maxLength": 3}}}
  }
}
