{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/invoice.presentation_settings.get.response.schema.json",
  "title": "invoice.presentation_settings.get response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "success",
    "capability",
    "status",
    "data",
    "warnings",
    "error",
    "odoo",
    "audit"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "success": {
      "type": "boolean"
    },
    "capability": {
      "const": "invoice.presentation_settings.get"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/item"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "response.schema.json#/$defs/error"
        }
      ]
    },
    "odoo": {
      "$ref": "response.schema.json#/$defs/odoo"
    },
    "audit": {
      "$ref": "response.schema.json#/$defs/audit"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "success": {
            "const": true
          }
        },
        "required": [
          "success"
        ]
      },
      "then": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "const": "verified"
          },
          "data": {
            "$ref": "#/$defs/item"
          },
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "data": {
            "type": "null"
          },
          "error": {
            "$ref": "response.schema.json#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "company_id": {
          "type": "integer",
          "minimum": 1
        },
        "move_type": {
          "enum": [
            "in_invoice",
            "in_receipt",
            "in_refund",
            "out_invoice",
            "out_receipt",
            "out_refund"
          ]
        },
        "state": {
          "enum": [
            "draft",
            "posted",
            "cancel"
          ]
        },
        "partner_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "partner_shipping_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "invoice_user_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "fiscal_position_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "narration": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "company_id",
        "fiscal_position_id",
        "id",
        "invoice_user_id",
        "move_type",
        "name",
        "narration",
        "partner_id",
        "partner_shipping_id",
        "state"
      ]
    }
  }
}
