{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/payment_term.line.create.request.schema.json",
  "title": "payment_term.line.create request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "context",
    "parameters"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "request_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "context": {
      "$ref": "request.schema.json#/$defs/context"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "payment_term_id": {
          "type": "integer",
          "minimum": 1
        },
        "line": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "enum": [
                "percent",
                "fixed"
              ]
            },
            "value_amount": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$(?![\\s\\S])"
            },
            "delay_type": {
              "enum": [
                "days_after",
                "days_after_end_of_month",
                "days_after_end_of_next_month",
                "days_end_of_month_on_the"
              ]
            },
            "nb_days": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            "days_next_month": {
              "type": "integer",
              "minimum": 0,
              "maximum": 31
            }
          },
          "required": [
            "days_next_month",
            "delay_type",
            "nb_days",
            "value",
            "value_amount"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "value": {
                    "const": "percent"
                  }
                },
                "required": [
                  "value"
                ]
              },
              "then": {
                "properties": {
                  "value_amount": {
                    "type": "string",
                    "maxLength": 256,
                    "pattern": "^(?:100(?:\\.0+)?|(?:[0-9]|[1-9][0-9])(?:\\.[0-9]+)?)$(?![\\s\\S])"
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "line",
        "payment_term_id"
      ]
    }
  }
}
