{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/fiscal_position.account_mappings.replace.request.schema.json",
  "title": "fiscal_position.account_mappings.replace request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "context",
    "parameters"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "context": {
      "$ref": "request.schema.json#/$defs/context"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fiscal_position_id",
        "mappings"
      ],
      "properties": {
        "fiscal_position_id": {
          "type": "integer",
          "minimum": 1
        },
        "mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_account_id",
              "destination_account_id"
            ],
            "properties": {
              "source_account_id": {
                "type": "integer",
                "minimum": 1
              },
              "destination_account_id": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    }
  }
}
