{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/invoice.lines.replace.request.schema.json",
  "title": "invoice.lines.replace request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "context",
    "parameters"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "request_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "context": {
      "$ref": "request.schema.json#/$defs/context"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "move_id",
        "lines"
      ],
      "properties": {
        "move_id": {
          "type": "integer",
          "minimum": 1
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "product_id",
              "account_id",
              "quantity",
              "price_unit",
              "discount",
              "tax_ids"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$"
              },
              "product_id": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "account_id": {
                "type": "integer",
                "minimum": 1
              },
              "quantity": {
                "$ref": "#/$defs/unsigned_decimal"
              },
              "price_unit": {
                "$ref": "#/$defs/signed_decimal"
              },
              "discount": {
                "$ref": "#/$defs/percentage_decimal"
              },
              "tax_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "analytic_distribution": {
                "$ref": "#/$defs/analytic_distribution"
              },
              "deferred_start_date": {
                "type": ["string", "null"],
                "format": "date"
              },
              "deferred_end_date": {
                "type": ["string", "null"],
                "format": "date"
              }
            },
            "dependentRequired": {
              "deferred_start_date": ["deferred_end_date"],
              "deferred_end_date": ["deferred_start_date"]
            },
            "oneOf": [
              {
                "properties": {
                  "deferred_start_date": {"type": "null"},
                  "deferred_end_date": {"type": "null"}
                }
              },
              {
                "required": ["deferred_start_date", "deferred_end_date"],
                "properties": {
                  "deferred_start_date": {"type": "string"},
                  "deferred_end_date": {"type": "string"}
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "unsigned_decimal": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$(?![\\s\\S])"
    },
    "signed_decimal": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$(?![\\s\\S])"
    },
    "percentage_decimal": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^(?:100(?:\\.0+)?|(?:[0-9]|[1-9][0-9])(?:\\.[0-9]+)?)$(?![\\s\\S])"
    },
    "analytic_percentage": {
      "type": "string",
      "maxLength": 8,
      "pattern": "^(?:100|(?:[1-9][0-9]?)(?:\\.[0-9]{0,3}[1-9])?|0\\.[0-9]{0,3}[1-9])$(?![\\s\\S])"
    },
    "analytic_distribution": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[1-9][0-9]*(?:,[1-9][0-9]*)*$(?![\\s\\S])"
          },
          "additionalProperties": {
            "$ref": "#/$defs/analytic_percentage"
          }
        }
      ]
    },
    "invoice_line": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "product_id",
        "account_id",
        "quantity",
        "price_unit",
        "discount",
        "tax_ids"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$"
        },
        "product_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "account_id": {
          "type": "integer",
          "minimum": 1
        },
        "quantity": {
          "$ref": "#/$defs/unsigned_decimal"
        },
        "price_unit": {
          "$ref": "#/$defs/signed_decimal"
        },
        "discount": {
          "$ref": "#/$defs/percentage_decimal"
        },
        "tax_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "analytic_distribution": {
          "$ref": "#/$defs/analytic_distribution"
        },
        "deferred_start_date": {
          "type": ["string", "null"],
          "format": "date"
        },
        "deferred_end_date": {
          "type": ["string", "null"],
          "format": "date"
        }
      },
      "dependentRequired": {
        "deferred_start_date": ["deferred_end_date"],
        "deferred_end_date": ["deferred_start_date"]
      },
      "oneOf": [
        {
          "properties": {
            "deferred_start_date": {"type": "null"},
            "deferred_end_date": {"type": "null"}
          }
        },
        {
          "required": ["deferred_start_date", "deferred_end_date"],
          "properties": {
            "deferred_start_date": {"type": "string"},
            "deferred_end_date": {"type": "string"}
          }
        }
      ]
    }
  }
}
