{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/inventory.on_hand.summary.response.schema.json",
  "title": "inventory.on_hand.summary response",
  "type": "object",
  "allOf": [
    {"$ref": "response.schema.json"},
    {
      "properties": {"capability": {"const": "inventory.on_hand.summary"}, "data": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/data"}]}},
      "allOf": [{"if": {"properties": {"success": {"const": true}}, "required": ["success"]}, "then": {"properties": {"request_id": {"type": "string", "format": "uuid"}, "status": {"const": "verified"}, "data": {"$ref": "#/$defs/data"}, "error": {"type": "null"}}}, "else": {"properties": {"data": {"type": "null"}, "error": {"$ref": "response.schema.json#/$defs/error"}}}}]
    }
  ],
  "$defs": {
    "decimal": {"type": "string", "maxLength": 256, "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$(?![\\s\\S])"},
    "nonnegativeDecimal": {"type": "string", "maxLength": 256, "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$(?![\\s\\S])"},
    "namedRef": {"type": "object", "additionalProperties": false, "required": ["id", "name"], "properties": {"id": {"type": "integer", "minimum": 1}, "name": {"type": "string", "minLength": 1}}},
    "codedRef": {"type": "object", "additionalProperties": false, "required": ["id", "code", "name"], "properties": {"id": {"type": "integer", "minimum": 1}, "code": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}}},
    "productRef": {"type": "object", "additionalProperties": false, "required": ["id", "code", "name"], "properties": {"id": {"type": "integer", "minimum": 1}, "code": {"type": ["string", "null"], "minLength": 1}, "name": {"type": "string", "minLength": 1}}},
    "group": {
      "type": "object", "additionalProperties": false, "required": ["product", "uom", "quantity", "reserved_quantity", "available_quantity"],
      "properties": {"product": {"$ref": "#/$defs/productRef"}, "uom": {"$ref": "#/$defs/namedRef"}, "quantity": {"$ref": "#/$defs/decimal"}, "reserved_quantity": {"$ref": "#/$defs/nonnegativeDecimal"}, "available_quantity": {"$ref": "#/$defs/decimal"}}
    },
    "data": {
      "type": "object", "additionalProperties": false, "required": ["company_id", "warehouse", "location", "groups"],
      "properties": {"company_id": {"type": "integer", "minimum": 1}, "warehouse": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/codedRef"}]}, "location": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/namedRef"}]}, "groups": {"type": "array", "items": {"$ref": "#/$defs/group"}}}
    }
  }
}
