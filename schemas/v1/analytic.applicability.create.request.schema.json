{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/analytic.applicability.create.request.schema.json",
  "title": "analytic.applicability.create request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "context", "parameters"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": "string", "format": "uuid"},
    "context": {"$ref": "request.schema.json#/$defs/context"},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "business_domain", "applicability", "account_prefix", "product_category_id"],
      "properties": {
        "plan_id": {"type": "integer", "minimum": 1},
        "business_domain": {"enum": ["general", "invoice", "bill"]},
        "applicability": {"enum": ["optional", "mandatory", "unavailable"]},
        "account_prefix": {"$ref": "#/$defs/nullablePrefix"},
        "product_category_id": {"type": ["integer", "null"], "minimum": 1}
      }
    }
  },
  "$defs": {
    "nullablePrefix": {"type": ["string", "null"], "minLength": 1, "maxLength": 64, "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$"}
  }
}
