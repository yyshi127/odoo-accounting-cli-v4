{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/reconciliation.candidates.list.request.schema.json",
  "title": "reconciliation.candidates.list request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "context", "parameters"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "context": {
      "allOf": [
        {"$ref": "request.schema.json#/$defs/context"},
        {
          "type": "object",
          "properties": {
            "database": {"type": "string", "pattern": "\\S"},
            "user_login": {"type": "string", "pattern": "\\S"},
            "language": {"type": "string", "pattern": "\\S"},
            "timezone": {"type": "string", "pattern": "\\S"}
          }
        }
      ]
    },
    "parameters": {"$ref": "#/$defs/parameters"}
  },
  "$defs": {
    "nullableDate": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "format": "date"}
      ]
    },
    "nullableId": {"type": ["integer", "null"], "minimum": 1},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "date_from": {"$ref": "#/$defs/nullableDate", "default": null},
        "date_to": {"$ref": "#/$defs/nullableDate", "default": null},
        "states": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["draft", "posted"]},
          "default": ["posted"]
        },
        "account_id": {"$ref": "#/$defs/nullableId", "default": null},
        "partner_id": {"$ref": "#/$defs/nullableId", "default": null},
        "journal_id": {"$ref": "#/$defs/nullableId", "default": null},
        "account_kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"enum": ["receivable", "payable", "other"]},
          "default": ["receivable", "payable", "other"]
        },
        "query": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$(?![\\s\\S])"
            }
          ],
          "default": null
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 100
        },
        "cursor": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 4096,
          "default": null
        }
      }
    }
  }
}
