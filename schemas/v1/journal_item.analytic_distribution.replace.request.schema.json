{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/journal_item.analytic_distribution.replace.request.schema.json",
  "title": "journal_item.analytic_distribution.replace request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "context",
    "parameters"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "request_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "context": {
      "$ref": "request.schema.json#/$defs/context"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "move_id",
        "line_id",
        "analytic_distribution"
      ],
      "properties": {
        "move_id": {
          "type": "integer",
          "minimum": 1
        },
        "line_id": {
          "type": "integer",
          "minimum": 1
        },
        "analytic_distribution": {
          "$ref": "invoice.lines.replace.request.schema.json#/$defs/invoice_line/properties/analytic_distribution"
        }
      }
    }
  }
}
