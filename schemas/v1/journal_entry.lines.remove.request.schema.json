{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/journal_entry.lines.remove.request.schema.json",
  "title": "journal_entry.lines.remove request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "context",
    "parameters"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "request_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "context": {
      "$ref": "request.schema.json#/$defs/context"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "move_id",
        "line_ids"
      ],
      "properties": {
        "move_id": {
          "type": "integer",
          "minimum": 1
        },
        "line_ids": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
