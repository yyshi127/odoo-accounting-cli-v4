{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/account.account.list.response.schema.json",
  "title": "account.account.list response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "success",
    "capability",
    "status",
    "data",
    "warnings",
    "error",
    "odoo",
    "audit"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "success": {
      "type": "boolean"
    },
    "capability": {
      "const": "account.account.list"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/data"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "response.schema.json#/$defs/error"
        }
      ]
    },
    "odoo": {
      "$ref": "response.schema.json#/$defs/odoo"
    },
    "audit": {
      "$ref": "response.schema.json#/$defs/audit"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "success": {
            "const": true
          }
        },
        "required": [
          "success"
        ]
      },
      "then": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "data": {
            "$ref": "#/$defs/data"
          },
          "error": {
            "type": "null"
          },
          "status": {
            "const": "verified"
          }
        }
      },
      "else": {
        "properties": {
          "data": {
            "type": "null"
          },
          "error": {
            "$ref": "response.schema.json#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "has_more",
        "next_cursor"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/account"
          }
        },
        "has_more": {
          "type": "boolean"
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "name",
        "account_type",
        "active",
        "reconcile",
        "company_ids"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "account_type": {
          "type": "string",
          "minLength": 1
        },
        "active": {
          "type": "boolean"
        },
        "reconcile": {
          "type": "boolean"
        },
        "company_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
