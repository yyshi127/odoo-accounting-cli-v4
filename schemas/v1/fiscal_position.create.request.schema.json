{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/fiscal_position.create.request.schema.json",
  "title": "fiscal_position.create request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "context",
    "parameters"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "context": {
      "$ref": "request.schema.json#/$defs/context"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "auto_apply": {
          "type": "boolean"
        },
        "vat_required": {
          "type": "boolean"
        },
        "country_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "country_group_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "state_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "zip_from": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 5000
        },
        "zip_to": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 5000
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 5000
        }
      }
    }
  }
}
