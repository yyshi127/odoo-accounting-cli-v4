{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/budget.lines.replace.request.schema.json",
  "title": "budget.lines.replace request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "context", "parameters"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
    "context": {"$ref": "request.schema.json#/$defs/context"},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["budget_id", "lines"],
      "properties": {
        "budget_id": {"type": "integer", "minimum": 1},
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["budget_amount", "analytic_account_ids"],
            "properties": {
              "budget_amount": {"$ref": "#/$defs/signedDecimal"},
              "analytic_account_ids": {
                "$comment": "Values must be strictly increasing; the public contract and runtime enforce ordering.",
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "signedDecimal": {"type": "string", "maxLength": 256, "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$(?![\\s\\S])"}
  }
}
