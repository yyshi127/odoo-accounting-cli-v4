{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/analytic.plan.create.request.schema.json",
  "title": "analytic.plan.create request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "context", "parameters"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
    "context": {"$ref": "request.schema.json#/$defs/context"},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "parent_plan_id"],
      "properties": {
        "name": {"$ref": "#/$defs/text"},
        "parent_plan_id": {"type": "integer", "minimum": 1},
        "color": {"type": "integer", "minimum": 0},
        "default_applicability": {"enum": ["optional", "mandatory", "unavailable"]}
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$"}
  }
}
