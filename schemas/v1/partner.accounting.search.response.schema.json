{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/partner.accounting.search.response.schema.json",
  "title": "partner.accounting.search response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "success", "capability", "status", "data", "warnings", "error", "odoo", "audit"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": ["string", "null"], "format": "uuid"},
    "success": {"type": "boolean"},
    "capability": {"const": "partner.accounting.search"},
    "status": {"type": "string", "minLength": 1},
    "data": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/data"}]},
    "warnings": {"type": "array", "items": {"type": "object"}},
    "error": {"oneOf": [{"type": "null"}, {"$ref": "response.schema.json#/$defs/error"}]},
    "odoo": {"$ref": "response.schema.json#/$defs/odoo"},
    "audit": {"$ref": "response.schema.json#/$defs/audit"}
  },
  "allOf": [{
    "if": {"properties": {"success": {"const": true}}, "required": ["success"]},
    "then": {
      "properties": {
        "request_id": {"type": "string", "format": "uuid"},
        "status": {"const": "verified"},
        "data": {"$ref": "#/$defs/data"},
        "error": {"type": "null"}
      }
    },
    "else": {
      "properties": {
        "data": {"type": "null"},
        "error": {"$ref": "response.schema.json#/$defs/error"}
      }
    }
  }],
  "$defs": {
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code", "name"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "code": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "complete_name", "ref", "active", "is_company", "company_id", "customer_rank", "supplier_rank", "receivable_account", "payable_account"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "complete_name": {"type": "string", "minLength": 1},
        "ref": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
        "active": {"type": "boolean"},
        "is_company": {"type": "boolean"},
        "company_id": {"type": ["integer", "null"], "minimum": 1},
        "customer_rank": {"type": "integer", "minimum": 0},
        "supplier_rank": {"type": "integer", "minimum": 0},
        "receivable_account": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/account"}]},
        "payable_account": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/account"}]}
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "has_more", "next_cursor"],
      "properties": {
        "items": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/item"}},
        "has_more": {"type": "boolean"},
        "next_cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096}
      }
    }
  }
}
