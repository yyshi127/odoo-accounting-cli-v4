{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/reconciliation.apply.request.schema.json",
  "title": "reconciliation.apply request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "context",
    "parameters"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "request_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "context": {
      "$ref": "request.schema.json#/$defs/context"
    },
    "parameters": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "line_ids"
          ],
          "properties": {
            "line_ids": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "invoice_id",
            "outstanding_line_id"
          ],
          "properties": {
            "invoice_id": {
              "type": "integer",
              "minimum": 1
            },
            "outstanding_line_id": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    }
  }
}
