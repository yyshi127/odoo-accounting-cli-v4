{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/report.catalog.list.response.schema.json",
  "title": "report.catalog.list response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "success", "capability", "status", "data", "warnings", "error", "odoo", "audit"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": ["string", "null"], "format": "uuid"},
    "success": {"type": "boolean"},
    "capability": {"const": "report.catalog.list"},
    "status": {"type": "string", "minLength": 1},
    "data": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/data"}]},
    "warnings": {"type": "array", "items": {"type": "object"}},
    "error": {"oneOf": [{"type": "null"}, {"$ref": "response.schema.json#/$defs/error"}]},
    "odoo": {"$ref": "response.schema.json#/$defs/odoo"},
    "audit": {"$ref": "response.schema.json#/$defs/audit"}
  },
  "allOf": [{"if": {"properties": {"success": {"const": true}}, "required": ["success"]}, "then": {"properties": {"request_id": {"type": "string", "format": "uuid"}, "status": {"const": "verified"}, "data": {"$ref": "#/$defs/data"}, "error": {"type": "null"}}}, "else": {"properties": {"data": {"type": "null"}, "error": {"$ref": "response.schema.json#/$defs/error"}}}}],
  "$defs": {
    "data": {
      "type": "object", "additionalProperties": false,
      "required": ["items", "has_more", "next_cursor"],
      "properties": {"items": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/item"}}, "has_more": {"type": "boolean"}, "next_cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096}},
      "allOf": [{"if": {"properties": {"has_more": {"const": true}}, "required": ["has_more"]}, "then": {"properties": {"items": {"type": "array", "minItems": 1}, "next_cursor": {"type": "string"}}}, "else": {"properties": {"next_cursor": {"type": "null"}}}}]
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "active", "root_report", "country", "availability_condition", "variants", "sections", "columns", "filters"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1},
        "active": {"type": "boolean"},
        "root_report": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/named"}]},
        "country": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/named"}]},
        "availability_condition": {"enum": ["country", "coa", "always"]},
        "variants": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/named"}},
        "sections": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/named"}},
        "columns": {"type": "array", "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/column"}},
        "filters": {"$ref": "#/$defs/filters"}
      }
    },
    "named": {"type": "object", "additionalProperties": false, "required": ["id", "name"], "properties": {"id": {"type": "integer", "minimum": 1}, "name": {"type": "string", "minLength": 1}}},
    "column": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "expression_label", "figure_type", "sortable", "blank_if_zero"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1},
        "expression_label": {"type": "string", "minLength": 1},
        "figure_type": {"enum": ["monetary", "percentage", "integer", "float", "date", "datetime", "boolean", "string"]},
        "sortable": {"type": "boolean"},
        "blank_if_zero": {"type": "boolean"}
      }
    },
    "filters": {
      "type": "object", "additionalProperties": false,
      "required": ["multi_company", "date_range", "show_draft", "unreconciled", "unfold_all", "journals", "analytic", "partner"],
      "properties": {
        "multi_company": {"enum": [null, "selector", "tax_units"]},
        "date_range": {"type": "boolean"},
        "show_draft": {"type": "boolean"},
        "unreconciled": {"type": "boolean"},
        "unfold_all": {"type": "boolean"},
        "journals": {"type": "boolean"},
        "analytic": {"type": "boolean"},
        "partner": {"type": "boolean"}
      }
    }
  }
}
