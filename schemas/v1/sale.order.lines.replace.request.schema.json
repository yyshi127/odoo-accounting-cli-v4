{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/sale.order.lines.replace.request.schema.json",
  "title": "sale.order.lines.replace request", "type": "object", "additionalProperties": false,
