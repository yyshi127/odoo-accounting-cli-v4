{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/tax.compute.request.schema.json",
  "title": "tax.compute request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "context",
    "parameters"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "request_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "context": {
      "$ref": "request.schema.json#/$defs/context"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tax_ids",
        "currency_id",
        "price_unit",
        "quantity"
      ],
      "properties": {
        "tax_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "maxItems": 100
        },
        "currency_id": {
          "type": "integer",
          "minimum": 1
        },
        "price_unit": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^(?:0|-?(?:0\\.[0-9]*[1-9]|[1-9][0-9]*(?:\\.[0-9]*[1-9])?))$(?![\\s\\S])"
        },
        "quantity": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^(?:0|-?(?:0\\.[0-9]*[1-9]|[1-9][0-9]*(?:\\.[0-9]*[1-9])?))$(?![\\s\\S])"
        },
        "product_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "partner_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "is_refund": {
          "type": "boolean"
        },
        "handle_price_include": {
          "type": "boolean"
        },
        "include_caba_tags": {
          "type": "boolean"
        }
      }
    }
  }
}
