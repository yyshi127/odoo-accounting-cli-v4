{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/purchase.order.analysis.summary.response.schema.json",
  "title": "purchase.order.analysis.summary response",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "request_id", "success", "capability", "status", "data", "warnings", "error", "odoo", "audit"],
  "properties": {
    "schema_version": {"const": "v1"}, "request_id": {"type": ["string", "null"], "format": "uuid"}, "success": {"type": "boolean"}, "capability": {"const": "purchase.order.analysis.summary"}, "status": {"type": "string", "minLength": 1},
    "data": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/data"}]}, "warnings": {"type": "array", "items": {"type": "object"}}, "error": {"oneOf": [{"type": "null"}, {"$ref": "response.schema.json#/$defs/error"}]}, "odoo": {"$ref": "response.schema.json#/$defs/odoo"}, "audit": {"$ref": "response.schema.json#/$defs/audit"}
  },
  "allOf": [{"if": {"properties": {"success": {"const": true}}, "required": ["success"]}, "then": {"properties": {"request_id": {"type": "string", "format": "uuid"}, "status": {"const": "verified"}, "data": {"$ref": "#/$defs/data"}, "error": {"type": "null"}}}, "else": {"properties": {"data": {"type": "null"}, "error": {"$ref": "response.schema.json#/$defs/error"}}}}],
  "$defs": {
    "currency": {"type": "object", "additionalProperties": false, "required": ["id", "code"], "properties": {"id": {"type": "integer", "minimum": 1}, "code": {"type": "string", "minLength": 1, "maxLength": 3}}},
    "decimal": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
    "group": {"type": "object", "additionalProperties": false, "required": ["id", "value"], "properties": {"id": {"type": ["integer", "null"], "minimum": 1}, "value": {"type": ["string", "null"], "minLength": 1}}},
    "total": {"type": "object", "additionalProperties": false, "required": ["currency", "order_count", "amount_untaxed", "amount_tax", "amount_total"], "properties": {"currency": {"$ref": "#/$defs/currency"}, "order_count": {"type": "integer", "minimum": 1}, "amount_untaxed": {"$ref": "#/$defs/decimal"}, "amount_tax": {"$ref": "#/$defs/decimal"}, "amount_total": {"$ref": "#/$defs/decimal"}}},
    "groupRow": {"type": "object", "additionalProperties": false, "required": ["group", "currency", "order_count", "amount_untaxed", "amount_tax", "amount_total"], "properties": {"group": {"$ref": "#/$defs/group"}, "currency": {"$ref": "#/$defs/currency"}, "order_count": {"type": "integer", "minimum": 1}, "amount_untaxed": {"$ref": "#/$defs/decimal"}, "amount_tax": {"$ref": "#/$defs/decimal"}, "amount_total": {"$ref": "#/$defs/decimal"}}},
    "data": {"type": "object", "additionalProperties": false, "required": ["company_id", "group_by", "date_from", "date_to", "groups", "totals_by_currency"], "properties": {"company_id": {"type": "integer", "minimum": 1}, "group_by": {"enum": ["state", "invoice_status", "partner", "buyer", "currency"]}, "date_from": {"type": "string", "format": "date"}, "date_to": {"type": "string", "format": "date"}, "groups": {"type": "array", "items": {"$ref": "#/$defs/groupRow"}}, "totals_by_currency": {"type": "array", "items": {"$ref": "#/$defs/total"}}}}
  }
}
