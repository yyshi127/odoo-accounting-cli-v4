{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/reconciliation.candidates.list.response.schema.json",
  "title": "reconciliation.candidates.list response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "success", "capability", "status", "data", "warnings", "error", "odoo", "audit"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": ["string", "null"], "format": "uuid"},
    "success": {"type": "boolean"},
    "capability": {"const": "reconciliation.candidates.list"},
    "status": {"type": "string", "minLength": 1},
    "data": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/data"}]},
    "warnings": {"type": "array", "items": {"type": "object"}},
    "error": {"oneOf": [{"type": "null"}, {"$ref": "response.schema.json#/$defs/error"}]},
    "odoo": {"$ref": "response.schema.json#/$defs/odoo"},
    "audit": {"$ref": "response.schema.json#/$defs/audit"}
  },
  "allOf": [{
    "if": {"properties": {"success": {"const": true}}, "required": ["success"]},
    "then": {
      "properties": {
        "request_id": {"type": "string", "format": "uuid"},
        "status": {"const": "verified"},
        "data": {"$ref": "#/$defs/data"},
        "error": {"type": "null"}
      }
    },
    "else": {
      "properties": {
        "data": {"type": "null"},
        "error": {"$ref": "response.schema.json#/$defs/error"}
      }
    }
  }],
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "nullableText": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/text"}]
    },
    "nullableDate": {
      "oneOf": [{"type": "null"}, {"type": "string", "format": "date"}]
    },
    "money": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$(?![\\s\\S])"
    },
    "nonzeroMoney": {
      "type": "string",
      "pattern": "^-?(?:(?:[1-9][0-9]*)(?:\\.[0-9]+)?|0\\.(?=[0-9]*[1-9])[0-9]+)$(?![\\s\\S])"
    },
    "currency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "code": {"type": "string", "minLength": 1, "maxLength": 3}
      }
    },
    "move": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "move_type", "ref"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "name": {"$ref": "#/$defs/nullableText"},
        "move_type": {
          "enum": ["entry", "out_invoice", "out_refund", "in_invoice", "in_refund", "out_receipt", "in_receipt"]
        },
        "ref": {"$ref": "#/$defs/nullableText"}
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code", "name", "account_type"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9.]+$(?![\\s\\S])"
        },
        "name": {"$ref": "#/$defs/text"},
        "account_type": {
          "enum": [
            "asset_receivable", "asset_cash", "asset_current", "asset_non_current",
            "asset_prepayments", "asset_fixed", "liability_payable",
            "liability_credit_card", "liability_current", "liability_non_current",
            "equity", "equity_unaffected", "income", "income_other", "expense",
            "expense_depreciation", "expense_direct_cost", "expense_other", "off_balance"
          ]
        }
      }
    },
    "partner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "name": {"$ref": "#/$defs/nullableText"}
      }
    },
    "journal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code", "name", "type"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "code": {"type": "string", "minLength": 1, "maxLength": 5},
        "name": {"$ref": "#/$defs/text"},
        "type": {"enum": ["sale", "purchase", "cash", "bank", "credit", "general"]}
      }
    },
    "historicalReconciliationModel": {
      "description": "The reconciliation rule that historically created this move line; it is not a recommended matching rule.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "name": {"$ref": "#/$defs/text"}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "date", "invoice_date", "date_maturity", "state", "move",
        "label", "account", "partner", "journal", "company_id",
        "company_currency", "currency", "balance", "amount_currency",
        "amount_residual", "amount_residual_currency", "matching_number",
        "reconciliation_model"
      ],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "date": {"type": "string", "format": "date"},
        "invoice_date": {"$ref": "#/$defs/nullableDate"},
        "date_maturity": {"$ref": "#/$defs/nullableDate"},
        "state": {"enum": ["draft", "posted"]},
        "move": {"$ref": "#/$defs/move"},
        "label": {"$ref": "#/$defs/nullableText"},
        "account": {"$ref": "#/$defs/account"},
        "partner": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/partner"}]},
        "journal": {"$ref": "#/$defs/journal"},
        "company_id": {"type": "integer", "minimum": 1},
        "company_currency": {"$ref": "#/$defs/currency"},
        "currency": {"$ref": "#/$defs/currency"},
        "balance": {"$ref": "#/$defs/money"},
        "amount_currency": {"$ref": "#/$defs/money"},
        "amount_residual": {"$ref": "#/$defs/nonzeroMoney"},
        "amount_residual_currency": {"$ref": "#/$defs/money"},
        "matching_number": {"$ref": "#/$defs/nullableText"},
        "reconciliation_model": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/historicalReconciliationModel"}
          ]
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "has_more", "next_cursor"],
      "properties": {
        "items": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/item"}},
        "has_more": {"type": "boolean"},
        "next_cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096}
      }
    }
  }
}
