{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/invoice.layout_line.create.request.schema.json",
  "title": "invoice.layout_line.create request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "context",
    "parameters"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "request_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "context": {
      "$ref": "request.schema.json#/$defs/context"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "move_id": {
          "type": "integer",
          "minimum": 1
        },
        "line": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "display_type": {
              "enum": [
                "line_note",
                "line_section",
                "line_subsection"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "\\S"
            },
            "sequence": {
              "type": "integer",
              "minimum": -2147483648,
              "maximum": 2147483647
            },
            "collapse_prices": {
              "type": "boolean"
            },
            "collapse_composition": {
              "type": "boolean"
            }
          },
          "required": [
            "collapse_composition",
            "collapse_prices",
            "display_type",
            "name",
            "sequence"
          ]
        }
      },
      "required": [
        "line",
        "move_id"
      ]
    }
  }
}
