{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/stock.transfer.search.response.schema.json",
  "title": "stock.transfer.search response",
  "type": "object",
  "allOf": [
    {"$ref": "response.schema.json"},
    {
      "properties": {
        "capability": {"const": "stock.transfer.search"},
        "data": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/data"}]}
      },
      "allOf": [{
        "if": {"properties": {"success": {"const": true}}, "required": ["success"]},
        "then": {"properties": {"request_id": {"type": "string", "format": "uuid"}, "status": {"const": "verified"}, "data": {"$ref": "#/$defs/data"}, "error": {"type": "null"}}},
        "else": {"properties": {"data": {"type": "null"}, "error": {"$ref": "response.schema.json#/$defs/error"}}}
      }]
    }
  ],
  "$defs": {
    "nullableText": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
    "nullableDateTime": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}]},
    "namedRef": {"type": "object", "additionalProperties": false, "required": ["id", "name"], "properties": {"id": {"type": "integer", "minimum": 1}, "name": {"type": "string", "minLength": 1}}},
    "operationType": {"type": "object", "additionalProperties": false, "required": ["id", "code", "name"], "properties": {"id": {"type": "integer", "minimum": 1}, "code": {"type": "string", "minLength": 1, "maxLength": 64}, "name": {"type": "string", "minLength": 1}}},
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "company_id", "name", "origin", "state", "operation_type", "scheduled_date", "completed_date", "source_location", "destination_location", "partner"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "company_id": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1},
        "origin": {"$ref": "#/$defs/nullableText"},
        "state": {"enum": ["draft", "waiting", "confirmed", "assigned", "done", "cancel"]},
        "operation_type": {"$ref": "#/$defs/operationType"},
        "scheduled_date": {"$ref": "#/$defs/nullableDateTime"},
        "completed_date": {"$ref": "#/$defs/nullableDateTime"},
        "source_location": {"$ref": "#/$defs/namedRef"},
        "destination_location": {"$ref": "#/$defs/namedRef"},
        "partner": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/namedRef"}]}
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "has_more", "next_cursor"],
      "properties": {
        "items": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/item"}},
        "has_more": {"type": "boolean"},
        "next_cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096}
      },
      "allOf": [{"if": {"properties": {"has_more": {"const": true}}, "required": ["has_more"]}, "then": {"properties": {"items": {"type": "array", "minItems": 1}, "next_cursor": {"type": "string"}}}, "else": {"properties": {"next_cursor": {"type": "null"}}}}]
    }
  }
}
