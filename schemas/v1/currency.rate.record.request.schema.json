{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/currency.rate.record.request.schema.json",
  "title": "currency.rate.record request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "context", "parameters"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": "string", "format": "uuid"},
    "context": {"$ref": "request.schema.json#/$defs/context"},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency_id", "date", "company_units_per_foreign_unit"],
      "properties": {
        "currency_id": {"type": "integer", "minimum": 1},
        "date": {"type": "string", "format": "date"},
        "company_units_per_foreign_unit": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^(?:[1-9][0-9]*|(?:0|[1-9][0-9]*)\\.[0-9]*[1-9])$"
        }
      }
    }
  }
}
