{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/stock.transfer.quantities.set.request.schema.json",
  "title": "stock.transfer.quantities.set request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "context", "parameters"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
    "context": {"$ref": "request.schema.json#/$defs/context"},
    "parameters": {"$ref": "#/$defs/parameters"}
  },
  "$defs": {
    "id": {"type": "integer", "minimum": 1},
    "nonnegative_decimal": {"type": "string", "maxLength": 256, "pattern": "^(?:0|[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9])$(?![\\s\\S])"},
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["move_id", "quantity"],
      "properties": {
        "move_id": {"$ref": "#/$defs/id"},
        "quantity": {"$ref": "#/$defs/nonnegative_decimal"}
      }
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transfer_id", "lines"],
      "properties": {
        "transfer_id": {"$ref": "#/$defs/id"},
        "lines": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"$ref": "#/$defs/line"}}
      }
    }
  }
}
