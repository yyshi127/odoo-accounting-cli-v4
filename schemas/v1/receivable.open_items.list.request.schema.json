{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/receivable.open_items.list.request.schema.json",
  "title": "receivable.open_items.list request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "context", "parameters"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "context": {"$ref": "request.schema.json#/$defs/context"},
    "parameters": {"$ref": "#/$defs/parameters"}
  },
  "$defs": {
    "nullableDate": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "format": "date"}
      ]
    },
    "nullableId": {"type": ["integer", "null"], "minimum": 1},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "date_from": {"$ref": "#/$defs/nullableDate", "default": null},
        "date_to": {"$ref": "#/$defs/nullableDate", "default": null},
        "due_date_from": {"$ref": "#/$defs/nullableDate", "default": null},
        "due_date_to": {"$ref": "#/$defs/nullableDate", "default": null},
        "partner_id": {"$ref": "#/$defs/nullableId", "default": null},
        "account_id": {"$ref": "#/$defs/nullableId", "default": null},
        "journal_id": {"$ref": "#/$defs/nullableId", "default": null},
        "currency_id": {"$ref": "#/$defs/nullableId", "default": null},
        "query": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "allOf": [
                {"not": {"pattern": "^\\s"}},
                {"not": {"pattern": "\\s$"}}
              ]
            }
          ],
          "default": null
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 100
        },
        "cursor": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 4096,
          "default": null
        }
      }
    }
  }
}
