{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/invoice.payment_schedule.inspect.response.schema.json",
  "title": "invoice.payment_schedule.inspect response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "success",
    "capability",
    "status",
    "data",
    "warnings",
    "error",
    "odoo",
    "audit"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "success": {
      "type": "boolean"
    },
    "capability": {
      "const": "invoice.payment_schedule.inspect"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/item"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "response.schema.json#/$defs/error"
        }
      ]
    },
    "odoo": {
      "$ref": "response.schema.json#/$defs/odoo"
    },
    "audit": {
      "$ref": "response.schema.json#/$defs/audit"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "success": {
            "const": true
          }
        },
        "required": [
          "success"
        ]
      },
      "then": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "const": "verified"
          },
          "data": {
            "$ref": "#/$defs/item"
          },
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "data": {
            "type": "null"
          },
          "error": {
            "$ref": "response.schema.json#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "company_id": {
          "type": "integer",
          "minimum": 1
        },
        "move_type": {
          "enum": [
            "in_invoice",
            "in_receipt",
            "in_refund",
            "out_invoice",
            "out_receipt",
            "out_refund"
          ]
        },
        "state": {
          "enum": [
            "draft",
            "posted",
            "cancel"
          ]
        },
        "currency_id": {
          "type": "integer",
          "minimum": 1
        },
        "company_currency_id": {
          "type": "integer",
          "minimum": 1
        },
        "payment_term_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "lines": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "date_maturity": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "discount_date": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "balance": {
                "type": "string",
                "maxLength": 256,
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$(?![\\s\\S])"
              },
              "amount_currency": {
                "type": "string",
                "maxLength": 256,
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$(?![\\s\\S])"
              },
              "discount_balance": {
                "type": "string",
                "maxLength": 256,
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$(?![\\s\\S])"
              },
              "discount_amount_currency": {
                "type": "string",
                "maxLength": 256,
                "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$(?![\\s\\S])"
              }
            },
            "required": [
              "amount_currency",
              "balance",
              "date_maturity",
              "discount_amount_currency",
              "discount_balance",
              "discount_date"
            ]
          }
        }
      },
      "required": [
        "company_currency_id",
        "company_id",
        "currency_id",
        "id",
        "lines",
        "move_type",
        "payment_term_id",
        "state"
      ]
    }
  }
}
