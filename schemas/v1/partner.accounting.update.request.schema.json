{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/partner.accounting.update.request.schema.json",
  "title": "partner.accounting.update request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "context", "parameters"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "context": {"$ref": "request.schema.json#/$defs/context"},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["partner_id", "changes"],
      "properties": {
        "partner_id": {"type": "integer", "minimum": 1},
        "changes": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "property_account_receivable_id": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "property_account_payable_id": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "property_account_position_id": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "property_payment_term_id": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "property_supplier_payment_term_id": {
              "type": ["integer", "null"],
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
