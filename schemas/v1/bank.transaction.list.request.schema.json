{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/bank.transaction.list.request.schema.json",
  "title": "bank.transaction.list request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "context", "parameters"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "context": {
      "allOf": [
        {"$ref": "request.schema.json#/$defs/context"},
        {
          "type": "object",
          "properties": {
            "database": {"type": "string", "pattern": "\\S"},
            "user_login": {"type": "string", "pattern": "\\S"},
            "language": {"type": "string", "pattern": "\\S"},
            "timezone": {"type": "string", "pattern": "\\S"}
          }
        }
      ]
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limit": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 100},
        "cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096, "default": null}
      }
    }
  }
}
