{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/financial-report.typed-data.schema.json",
  "title": "Typed Odoo financial report data",
  "type": "object",
  "additionalProperties": false,
  "required": ["report", "date", "currency", "basis", "columns", "lines", "has_more", "next_cursor"],
  "properties": {
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "name"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "date": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {"type": "string", "format": "date"},
        "to": {"type": "string", "format": "date"}
      }
    },
    "currency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code", "decimal_places"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "code": {"type": "string", "minLength": 1, "maxLength": 3},
        "decimal_places": {"type": "integer", "minimum": 0}
      }
    },
    "basis": {"const": "posted_entries"},
    "columns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/column"}
    },
    "lines": {
      "type": "array",
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/line"}
    },
    "has_more": {"type": "boolean"},
    "next_cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096}
  },
  "$defs": {
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "label", "expression_label", "figure_type"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "label": {"type": "string", "minLength": 1},
        "expression_label": {"type": "string", "minLength": 1},
        "figure_type": {"enum": ["monetary", "float", "percentage", "integer", "date", "string"]}
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parent_id", "name", "level", "unfoldable", "values"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 4096},
        "parent_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096},
        "name": {"type": "string", "minLength": 1},
        "level": {"type": "integer", "minimum": 0},
        "unfoldable": {"type": "boolean"},
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"type": ["string", "null"]}
        }
      }
    }
  }
}
