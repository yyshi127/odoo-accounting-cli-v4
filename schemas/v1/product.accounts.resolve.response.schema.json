{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/product.accounts.resolve.response.schema.json",
  "title": "product.accounts.resolve response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "success",
    "capability",
    "status",
    "data",
    "warnings",
    "error",
    "odoo",
    "audit"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "success": {
      "type": "boolean"
    },
    "capability": {
      "const": "product.accounts.resolve"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/item"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "response.schema.json#/$defs/error"
        }
      ]
    },
    "odoo": {
      "$ref": "response.schema.json#/$defs/odoo"
    },
    "audit": {
      "$ref": "response.schema.json#/$defs/audit"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "success": {
            "const": true
          }
        },
        "required": [
          "success"
        ]
      },
      "then": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "const": "verified"
          },
          "data": {
            "$ref": "#/$defs/item"
          },
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "data": {
            "type": "null"
          },
          "error": {
            "$ref": "response.schema.json#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "company_id",
        "template_id",
        "fiscal_position_id",
        "income_account_id",
        "expense_account_id",
        "stock_valuation_account_id",
        "stock_variation_account_id",
        "stock_journal_id"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "company_id": {
          "type": "integer",
          "minimum": 1
        },
        "template_id": {
          "type": "integer",
          "minimum": 1
        },
        "fiscal_position_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "income_account_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "expense_account_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "stock_valuation_account_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "stock_variation_account_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "stock_journal_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    }
  }
}
