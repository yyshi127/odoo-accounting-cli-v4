{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/cash_rounding.compute.request.schema.json",
  "title": "cash_rounding.compute request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "context",
    "parameters"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "request_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "context": {
      "$ref": "request.schema.json#/$defs/context"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cash_rounding_id",
        "currency_id",
        "amount"
      ],
      "properties": {
        "cash_rounding_id": {
          "type": "integer",
          "minimum": 1
        },
        "currency_id": {
          "type": "integer",
          "minimum": 1
        },
        "amount": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^(?:0|-?(?:0\\.[0-9]*[1-9]|[1-9][0-9]*(?:\\.[0-9]*[1-9])?))$(?![\\s\\S])"
        }
      }
    }
  },
  "$defs": {
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cash_rounding_id"
      ],
      "properties": {
        "cash_rounding_id": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
