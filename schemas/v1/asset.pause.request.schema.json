{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/asset.pause.request.schema.json",
  "title": "asset.pause request",
  "type": "object",
  "allOf": [
    {"$ref": "request.schema.json"},
    {
      "properties": {
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["asset_id", "date", "note"],
          "properties": {
            "asset_id": {"type": "integer", "minimum": 1},
            "date": {"type": "string", "format": "date"},
            "note": {
              "type": ["string", "null"],
              "maxLength": 200,
              "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$"
            }
          }
        }
      }
    }
  ]
}
