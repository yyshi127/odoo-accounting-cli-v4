{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/journal_item.search.request.schema.json",
  "title": "journal_item.search request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "context",
    "parameters"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "request_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "context": {
      "$ref": "request.schema.json#/$defs/context"
    },
    "parameters": {
      "$ref": "#/$defs/parameters"
    }
  },
  "$defs": {
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "date_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "date_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "move_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "account_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "partner_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "journal_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "posted_only": {
          "type": "boolean",
          "default": false
        },
        "currency_id": {"type": "integer", "minimum": 1},
        "product_id": {"type": "integer", "minimum": 1},
        "tax_id": {"type": "integer", "minimum": 1},
        "due_date_from": {"type": ["string", "null"], "format": "date"},
        "due_date_to": {"type": ["string", "null"], "format": "date"},
        "reconciled": {"type": "boolean"},
        "move_types": {
          "type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true,
          "items": {"enum": ["entry", "out_invoice", "out_refund", "in_invoice", "in_refund", "out_receipt", "in_receipt"]}
        },
        "query": {"type": ["string", "null"], "minLength": 1, "maxLength": 200, "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$(?![\\s\\S])"},
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 100
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 4096,
          "default": null
        }
      }
    }
  }
}
