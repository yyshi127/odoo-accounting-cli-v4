{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/cogs.entries.list.response.schema.json",
  "title": "cogs.entries.list response",
  "type": "object",
  "allOf": [
    {"$ref": "response.schema.json"},
    {
      "properties": {
        "capability": {"const": "cogs.entries.list"},
        "data": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/data"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"success": {"const": true}}, "required": ["success"]},
          "then": {
            "properties": {
              "request_id": {"type": "string", "format": "uuid"},
              "status": {"const": "verified"},
              "data": {"$ref": "#/$defs/data"},
              "error": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "data": {"type": "null"},
              "error": {"$ref": "response.schema.json#/$defs/error"}
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "decimal": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$(?![\\s\\S])"
    },
    "nullableText": {
      "oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]
    },
    "namedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code", "name"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "code": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "currency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "code": {"type": "string", "minLength": 1, "maxLength": 3}
      }
    },
    "invoice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "move_type", "state"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "name": {"$ref": "#/$defs/nullableText"},
        "move_type": {"enum": ["out_invoice", "out_refund"]},
        "state": {"const": "posted"}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "date",
        "company_id",
        "invoice",
        "origin_invoice_line_id",
        "account",
        "product",
        "label",
        "quantity",
        "debit",
        "credit",
        "balance",
        "company_currency",
        "sale_order_line_ids",
        "stock_move_ids"
      ],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "date": {"type": "string", "format": "date"},
        "company_id": {"type": "integer", "minimum": 1},
        "invoice": {"$ref": "#/$defs/invoice"},
        "origin_invoice_line_id": {"type": ["integer", "null"], "minimum": 1},
        "account": {"$ref": "#/$defs/account"},
        "product": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/namedRef"}]},
        "label": {"$ref": "#/$defs/nullableText"},
        "quantity": {"$ref": "#/$defs/decimal"},
        "debit": {"$ref": "#/$defs/decimal"},
        "credit": {"$ref": "#/$defs/decimal"},
        "balance": {"$ref": "#/$defs/decimal"},
        "company_currency": {"$ref": "#/$defs/currency"},
        "sale_order_line_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "stock_move_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "has_more", "next_cursor"],
      "properties": {
        "items": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/item"}},
        "has_more": {"type": "boolean"},
        "next_cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096}
      },
      "allOf": [
        {
          "if": {"properties": {"has_more": {"const": true}}, "required": ["has_more"]},
          "then": {
            "properties": {
              "items": {"type": "array", "minItems": 1},
              "next_cursor": {"type": "string"}
            }
          },
          "else": {"properties": {"next_cursor": {"type": "null"}}}
        }
      ]
    }
  }
}
