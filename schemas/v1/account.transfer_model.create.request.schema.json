{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/account.transfer_model.create.request.schema.json",
  "title": "account.transfer_model.create request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "context", "parameters"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
    "context": {"$ref": "request.schema.json#/$defs/context"},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "journal_id", "date_start", "date_stop", "frequency", "origin_account_ids", "destination_lines"],
      "properties": {
        "name": {"$ref": "#/$defs/text256"},
        "journal_id": {"$ref": "#/$defs/id"},
        "date_start": {"type": "string", "format": "date"},
        "date_stop": {"type": ["string", "null"], "format": "date"},
        "frequency": {"enum": ["month", "quarter", "year"]},
        "origin_account_ids": {"$ref": "#/$defs/idList"},
        "destination_lines": {"$ref": "#/$defs/destinationLines"}
      }
    }
  },
  "$defs": {
    "id": {"type": "integer", "minimum": 1},
    "text256": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$(?![\\s\\S])"},
    "positivePercentage": {"type": "string", "maxLength": 9, "pattern": "^(?:100|(?:[1-9]|[1-9][0-9])(?:\\.[0-9]{0,5}[1-9])?|0\\.[0-9]{0,5}[1-9])$(?![\\s\\S])"},
    "idList": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "destinationLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account_id", "percentage"],
      "properties": {
        "account_id": {"$ref": "#/$defs/id"},
        "percentage": {"$ref": "#/$defs/positivePercentage"}
      }
    },
    "destinationLines": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/$defs/destinationLine"}}
  }
}
