{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/journal.create.request.schema.json",
  "title": "journal.create request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "context", "parameters"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
    "context": {"$ref": "request.schema.json#/$defs/context"},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "code", "type"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "code": {"$ref": "#/$defs/code"},
        "type": {"enum": ["sale", "purchase", "cash", "bank", "credit", "general"]},
        "sequence": {"type": "integer", "minimum": 0},
        "currency_id": {"type": ["integer", "null"], "minimum": 1},
        "default_account_id": {"type": ["integer", "null"], "minimum": 1}
      }
    }
  },
  "$defs": {
    "name": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$"},
    "code": {"type": "string", "minLength": 1, "maxLength": 5, "pattern": "^[A-Za-z0-9]{1,5}$"}
  }
}
