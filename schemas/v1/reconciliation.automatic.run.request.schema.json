{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/reconciliation.automatic.run.request.schema.json",
  "title": "reconciliation.automatic.run request",
  "type": "object",
  "allOf": [
    {"$ref": "request.schema.json"},
    {
      "properties": {
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["line_ids"],
          "properties": {
            "line_ids": {
              "type": "array",
              "minItems": 2,
              "maxItems": 200,
              "uniqueItems": true,
              "items": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    }
  ]
}
