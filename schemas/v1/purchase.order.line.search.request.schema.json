{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/purchase.order.line.search.request.schema.json",
  "title": "purchase.order.line.search request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "context", "parameters"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"},
    "context": {"$ref": "request.schema.json#/$defs/context"},
    "parameters": {"$ref": "#/$defs/parameters"}
  },
  "$defs": {
    "nullableDate": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date"}]},
    "nullableId": {"type": ["integer", "null"], "minimum": 1},
    "nullableStates": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["draft", "sent", "to approve", "purchase", "cancel"]}}]},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "order_id": {"$ref": "#/$defs/nullableId"},
        "date_from": {"$ref": "#/$defs/nullableDate"},
        "date_to": {"$ref": "#/$defs/nullableDate"},
        "partner_id": {"$ref": "#/$defs/nullableId"},
        "product_id": {"$ref": "#/$defs/nullableId"},
        "states": {"$ref": "#/$defs/nullableStates"},
        "to_receive_only": {"type": "boolean", "default": false},
        "to_invoice_only": {"type": "boolean", "default": false},
        "limit": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 100},
        "cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096, "default": null}
      }
    }
  }
}
