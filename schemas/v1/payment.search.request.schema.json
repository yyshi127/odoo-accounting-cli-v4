{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/payment.search.request.schema.json",
  "title": "payment.search request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "context", "parameters"],
  "properties": {
    "schema_version": {"const": "v1"},
    "request_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "context": {
      "allOf": [
        {"$ref": "request.schema.json#/$defs/context"},
        {
          "type": "object",
          "properties": {
            "database": {"type": "string", "pattern": "\\S"},
            "user_login": {"type": "string", "pattern": "\\S"},
            "language": {"type": "string", "pattern": "\\S"},
            "timezone": {"type": "string", "pattern": "\\S"}
          }
        }
      ]
    },
    "parameters": {"$ref": "#/$defs/parameters"}
  },
  "$defs": {
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "limit": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 100},
        "cursor": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096, "default": null},
        "date_from": {"type": ["string", "null"], "format": "date", "default": null},
        "date_to": {"type": ["string", "null"], "format": "date", "default": null},
        "states": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"enum": ["draft", "in_process", "paid", "canceled", "rejected"]}
        },
        "payment_types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["inbound", "outbound"]}
        },
        "partner_types": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["customer", "supplier"]}
        },
        "journal_id": {"type": ["integer", "null"], "minimum": 1, "default": null},
        "partner_id": {"type": ["integer", "null"], "minimum": 1, "default": null},
        "currency_id": {"type": ["integer", "null"], "minimum": 1, "default": null},
        "query": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^(?:\\S|\\S[\\s\\S]*\\S)$(?![\\s\\S])"
            }
          ],
          "default": null
        }
      }
    }
  }
}
