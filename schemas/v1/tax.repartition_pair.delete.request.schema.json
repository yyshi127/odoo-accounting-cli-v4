{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/tax.repartition_pair.delete.request.schema.json",
  "title": "tax.repartition_pair.delete request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "context",
    "parameters"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "request_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "context": {
      "$ref": "request.schema.json#/$defs/context"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tax_id": {
          "type": "integer",
          "minimum": 1
        },
        "invoice_line_id": {
          "type": "integer",
          "minimum": 1
        },
        "refund_line_id": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "invoice_line_id",
        "refund_line_id",
        "tax_id"
      ]
    }
  }
}
