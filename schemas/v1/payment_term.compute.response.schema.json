{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sudotech.ai/odoo-accounting-cli-v4/v1/payment_term.compute.response.schema.json",
  "title": "payment_term.compute response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "success",
    "capability",
    "status",
    "data",
    "warnings",
    "error",
    "odoo",
    "audit"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "success": {
      "type": "boolean"
    },
    "capability": {
      "const": "payment_term.compute"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/item"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "response.schema.json#/$defs/error"
        }
      ]
    },
    "odoo": {
      "$ref": "response.schema.json#/$defs/odoo"
    },
    "audit": {
      "$ref": "response.schema.json#/$defs/audit"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "success": {
            "const": true
          }
        },
        "required": [
          "success"
        ]
      },
      "then": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "const": "verified"
          },
          "data": {
            "$ref": "#/$defs/item"
          },
          "error": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "data": {
            "type": "null"
          },
          "error": {
            "$ref": "response.schema.json#/$defs/error"
          }
        }
      }
    }
  ],
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "company_id",
        "currency_id",
        "company_currency_id",
        "input",
        "total_amount",
        "discount_percentage",
        "discount_date",
        "discount_balance",
        "discount_amount_currency",
        "line_ids"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "company_id": {
          "type": "integer",
          "minimum": 1
        },
        "currency_id": {
          "type": "integer",
          "minimum": 1
        },
        "company_currency_id": {
          "type": "integer",
          "minimum": 1
        },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "payment_term_id",
            "date_ref",
            "currency_id",
            "tax_amount",
            "tax_amount_currency",
            "untaxed_amount",
            "untaxed_amount_currency",
            "sign",
            "cash_rounding_id"
          ],
          "properties": {
            "payment_term_id": {
              "type": "integer",
              "minimum": 1
            },
            "date_ref": {
              "type": "string",
              "format": "date",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$(?![\\s\\S])"
            },
            "currency_id": {
              "type": "integer",
              "minimum": 1
            },
            "tax_amount": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^(?:0|-?(?:0\\.[0-9]*[1-9]|[1-9][0-9]*(?:\\.[0-9]*[1-9])?))$(?![\\s\\S])"
            },
            "tax_amount_currency": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^(?:0|-?(?:0\\.[0-9]*[1-9]|[1-9][0-9]*(?:\\.[0-9]*[1-9])?))$(?![\\s\\S])"
            },
            "untaxed_amount": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^(?:0|-?(?:0\\.[0-9]*[1-9]|[1-9][0-9]*(?:\\.[0-9]*[1-9])?))$(?![\\s\\S])"
            },
            "untaxed_amount_currency": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^(?:0|-?(?:0\\.[0-9]*[1-9]|[1-9][0-9]*(?:\\.[0-9]*[1-9])?))$(?![\\s\\S])"
            },
            "sign": {
              "type": "integer",
              "enum": [
                -1,
                1
              ]
            },
            "cash_rounding_id": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          }
        },
        "total_amount": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^(?:0|-?(?:0\\.[0-9]*[1-9]|[1-9][0-9]*(?:\\.[0-9]*[1-9])?))$(?![\\s\\S])"
        },
        "discount_percentage": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^(?:0|0\\.[0-9]*[1-9]|[1-9][0-9]*(?:\\.[0-9]*[1-9])?)$(?![\\s\\S])"
        },
        "discount_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$(?![\\s\\S])"
        },
        "discount_balance": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^(?:0|-?(?:0\\.[0-9]*[1-9]|[1-9][0-9]*(?:\\.[0-9]*[1-9])?))$(?![\\s\\S])"
        },
        "discount_amount_currency": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^(?:0|-?(?:0\\.[0-9]*[1-9]|[1-9][0-9]*(?:\\.[0-9]*[1-9])?))$(?![\\s\\S])"
        },
        "line_ids": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "company_amount",
              "foreign_amount"
            ],
            "properties": {
              "date": {
                "type": "string",
                "format": "date",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$(?![\\s\\S])"
              },
              "company_amount": {
                "type": "string",
                "maxLength": 256,
                "pattern": "^(?:0|-?(?:0\\.[0-9]*[1-9]|[1-9][0-9]*(?:\\.[0-9]*[1-9])?))$(?![\\s\\S])"
              },
              "foreign_amount": {
                "type": "string",
                "maxLength": 256,
                "pattern": "^(?:0|-?(?:0\\.[0-9]*[1-9]|[1-9][0-9]*(?:\\.[0-9]*[1-9])?))$(?![\\s\\S])"
              }
            }
          }
        }
      }
    }
  }
}
